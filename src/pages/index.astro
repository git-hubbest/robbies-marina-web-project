---
import Layout from '../layouts/Layout.astro';
import ActivityCard from '../components/ActivityCard.astro';
import BookingCTA from '../components/BookingCTA.astro';

const activities = [
  { title: 'Tarpon Feeding', description: 'Hand-feed massive tarpon in the world-famous feeding frenzy at Robbie\'s dock.', href: '/activities', emoji: '🐟', gradient: 'from-teal-800 to-teal-600' },
  { title: 'Glass Bottom Boat', description: 'Explore Islamorada\'s stunning reefs aboard the Seakeeper-stabilized Transparensea.', href: '/glass-bottom-boat', emoji: '🪸', gradient: 'from-blue-800 to-cyan-600' },
  { title: 'Snorkeling Tours', description: 'Dive into crystal-clear Florida Keys waters. Two trips daily at 10am & 1:30pm.', href: '/snorkeling', emoji: '🤿', gradient: 'from-cyan-800 to-blue-600' },
  { title: 'Sport Fishing', description: 'Three party boat trips daily with Captain Michael. All bait & tackle included.', href: '/fishing', emoji: '🎣', gradient: 'from-slate-800 to-blue-800' },
  { title: 'Kayak & Paddleboard', description: 'Explore mangrove eco-systems and two Florida state parks from The Kayak Shack.', href: '/kayak-paddleboard', emoji: '🚣', gradient: 'from-green-800 to-teal-700' },
  { title: 'Jet Ski Tours', description: '14–22 mile tours through turquoise bays. Spot dolphins and manatees in the wild.', href: '/kayak-paddleboard', emoji: '💨', gradient: 'from-blue-700 to-indigo-700' },
  { title: 'Sunset Cruises', description: 'Three options from intimate to grand — catamaran, private deck boat, or luxury yacht.', href: '/sunset-cruises', emoji: '🌅', gradient: 'from-orange-700 to-rose-700' },
  { title: 'Eco Tours', description: '2-hour Florida Bay expeditions through mangrove islands and sea grass beds.', href: '/eco-tours', emoji: '🌿', gradient: 'from-green-700 to-emerald-600' },
  { title: 'Boat Rentals', description: 'Set your own course across Florida Bay and the Atlantic. Prime Islamorada access.', href: '/boat-rentals', emoji: '⛵', gradient: 'from-sky-800 to-blue-700' },
  { title: 'SNUBA Diving', description: 'Guided underwater adventures — deeper than snorkeling, no certification required.', href: '/activities', emoji: '🌊', gradient: 'from-indigo-800 to-blue-700' },
  { title: 'Four Aces Yacht', description: 'Luxury 55-foot Hatteras yacht charter. Fish Islamorada or cruise to the Bahamas.', href: '/four-aces', emoji: '🛥️', gradient: 'from-amber-800 to-yellow-700' },
  { title: 'History Tours', description: 'Brad Bertelli\'s Keys history experience — conch chowder, rumrunner & Key lime pie.', href: '/history-tours', emoji: '📜', gradient: 'from-stone-700 to-amber-700' },
];
---

<Layout title="Home">
  <!-- Hero -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden" style="background: linear-gradient(135deg, #0a1628 0%, #1a3a5c 50%, #0d2137 100%);">
    <div class="absolute inset-0 opacity-20" style="background-image: url('data:image/svg+xml,%3Csvg width=%2260%22 height=%2260%22 viewBox=%220 0 60 60%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cg fill=%22none%22 fill-rule=%22evenodd%22%3E%3Cg fill=%22%23ffffff%22 fill-opacity=%220.05%22%3E%3Cpath d=%22M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z%22/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>

    <div class="relative z-10 text-center px-6 max-w-4xl mx-auto">
      <p class="text-amber-400 text-sm font-semibold uppercase tracking-widest mb-6">Islamorada, Florida Keys</p>
      <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold text-white mb-6 leading-tight" style="font-family: 'Playfair Display', serif;">
        Voted #1 Place in the Florida Keys
      </h1>
      <p class="text-white/70 text-lg md:text-xl mb-10 max-w-2xl mx-auto leading-relaxed">
        Every tourist should visit. Home of the world-famous tarpon feeding, world-class fishing, snorkeling, and unforgettable adventures.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="#activities" class="bg-amber-500 hover:bg-amber-400 text-white px-8 py-4 rounded font-semibold text-lg transition-colors shadow-xl">
          Explore Activities
        </a>
        <a href="https://fareharbor.com/hungrytarpon/" target="_blank" rel="noopener"
          class="border-2 border-white/50 hover:border-white text-white px-8 py-4 rounded font-semibold text-lg transition-colors">
          Book Now
        </a>
      </div>
    </div>

    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
      <svg class="w-6 h-6 text-white/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
      </svg>
    </div>
  </section>

  <!-- Featured In -->
  <section class="py-12 px-6 bg-gray-50 border-b border-gray-200">
    <div class="max-w-5xl mx-auto text-center">
      <p class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-8">Featured In</p>
      <div class="flex flex-wrap justify-center items-center gap-8 md:gap-16">
        {['National Geographic', 'Vogue', 'New York Times', 'Hilton Grand Vacations'].map(pub => (
          <span class="text-gray-500 font-semibold text-lg tracking-wide">{pub}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- Welcome -->
  <section class="py-24 px-6">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-amber-600 text-sm font-semibold uppercase tracking-widest mb-4">Welcome to Robbie's</p>
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6" style="font-family: 'Playfair Display', serif;">
        The Heart of the Florida Keys
      </h2>
      <p class="text-gray-600 text-lg leading-relaxed mb-6">
        Just an hour from Miami, Robbie's Marina of Islamorada is where the Florida Keys come alive. Whether you want to hand-feed massive tarpon, seek thrills on the water, or simply soak in the beauty of this legendary island — we've got something for everyone.
      </p>
      <p class="text-gray-600 text-lg leading-relaxed italic">
        "Close to perfect, far from normal."
      </p>
    </div>
  </section>

  <!-- Hours -->
  <section class="py-16 px-6" style="background-color: #0a1628;">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-center text-2xl font-bold text-white mb-12" style="font-family: 'Playfair Display', serif;">Hours of Operation</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { name: "Robbie's of Islamorada", hours: "7:00am – 9:00pm", days: "Mon–Sun" },
          { name: "Tarpon Booth", hours: "7:00am – 9:00pm", days: "Mon–Sun" },
          { name: "Hungry Tarpon Restaurant", hours: "6:30am – 9:00pm", days: "Mon–Sun" },
          { name: "Captain Michael Fishing", hours: "7:00am – 8:00pm", days: "Mon–Sun" },
        ].map(item => (
          <div class="bg-white/5 border border-white/10 rounded-xl p-6 text-center">
            <p class="text-amber-400 text-sm font-semibold mb-3">{item.days}</p>
            <h3 class="text-white font-semibold mb-2">{item.name}</h3>
            <p class="text-white/60 text-sm">{item.hours}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Activities -->
  <section id="activities" class="py-24 px-6 bg-gray-50">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <p class="text-amber-600 text-sm font-semibold uppercase tracking-widest mb-4">Things To Do</p>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900" style="font-family: 'Playfair Display', serif;">
          The Best of the Florida Keys, All in One Place
        </h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {activities.map(activity => (
          <ActivityCard {...activity} />
        ))}
      </div>
    </div>
  </section>

  <BookingCTA />
</Layout>
