---
import Layout from '../layouts/Layout.astro';
import BookingCTA from '../components/BookingCTA.astro';
---

<Layout title="History Tours with Brad Bertelli" description="Florida Keys history tours at Robbie's Marina. Brad Bertelli's signature experience — rumrunner, conch chowder, fritters & Key lime pie.">
  <section class="pt-32 pb-20 px-6 text-center text-white" style="background: linear-gradient(135deg, #1a1000, #3a2a00, #5a3a00);">
    <p class="text-amber-400 text-sm font-semibold uppercase tracking-widest mb-4">Mondays & Thursdays</p>
    <h1 class="text-4xl md:text-5xl font-bold mb-6" style="font-family: 'Playfair Display', serif;">Tasting Florida Keys History</h1>
    <p class="text-white/70 text-lg max-w-2xl mx-auto">With local historian Brad Bertelli — dive into the rich history and flavors of the Florida Keys in one unforgettable hour.</p>
  </section>

  <section class="py-20 px-6">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-gray-600 text-lg leading-relaxed mb-12">Sip a rumrunner, savor traditional conch chowder and fritters, and finish with a sweet slice of Key lime pie. This one-hour exclusive experience combines fascinating stories and iconic island dishes for a true taste of Conch culture and the Conch Republic.</p>

      <div class="grid sm:grid-cols-2 gap-6 mb-12">
        <div class="border-2 border-amber-200 rounded-xl p-8 text-center hover:border-amber-400 transition-colors">
          <p class="text-amber-600 font-semibold uppercase text-sm tracking-widest mb-3">Morning Slot</p>
          <p class="text-3xl font-bold text-gray-900 mb-1">11:30am</p>
          <p class="text-gray-500">to 12:30pm</p>
        </div>
        <div class="border-2 border-amber-200 rounded-xl p-8 text-center hover:border-amber-400 transition-colors">
          <p class="text-amber-600 font-semibold uppercase text-sm tracking-widest mb-3">Afternoon Slot</p>
          <p class="text-3xl font-bold text-gray-900 mb-1">2:30pm</p>
          <p class="text-gray-500">to 3:30pm</p>
        </div>
      </div>

      <div class="bg-amber-50 rounded-xl p-6 mb-8 text-left">
        <p class="font-semibold text-amber-800 mb-3">🍽 What's Included</p>
        <ul class="space-y-2 text-amber-900 text-sm">
          {['Rumrunner cocktail', 'Traditional conch chowder', 'Conch fritters', 'Slice of Key lime pie', '1 hour of Florida Keys history with Brad Bertelli'].map(item => (
            <li class="flex items-center gap-2"><span>✓</span> {item}</li>
          ))}
        </ul>
      </div>

      <p class="text-gray-500 text-sm mb-8">Available Mondays & Thursdays only. Reservations required.</p>

      <a href="https://fareharbor.com/embeds/book/hungrytarpon/?full-items=yes" target="_blank" rel="noopener"
        class="inline-block bg-amber-500 hover:bg-amber-400 text-white px-10 py-4 rounded font-bold text-lg transition-colors shadow-lg">
        Book Your Seat Now
      </a>
    </div>
  </section>
</Layout>
