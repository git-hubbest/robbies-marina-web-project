---
import Layout from '../layouts/Layout.astro';
import BookingCTA from '../components/BookingCTA.astro';

const trips = [
  {
    name: "Morning Trip",
    time: "9:00am – 2:00pm",
    price: "$100",
    icon: "🌅",
    bookLink: "https://fareharbor.com/embeds/book/robbies/items/27136/?full-items=yes&flow=13390",
    highlight: true,
  },
  {
    name: "Afternoon Trip",
    time: "2:30pm – 6:30pm",
    price: "$75",
    icon: "☀️",
    bookLink: "https://fareharbor.com/embeds/book/robbies/items/27136/?full-items=yes&flow=13390",
    highlight: false,
  },
  {
    name: "Night Trip",
    time: "7:30pm – 12:30am",
    price: "$100",
    icon: "🌙",
    bookLink: "https://fareharbor.com/embeds/book/robbies/items/27137/?full-items=yes&flow=13390",
    highlight: false,
  },
];
---

<Layout title="Captain Michael Party Boat Fishing" description="Captain Michael Party Boat Fishing at Robbie's Marina, Islamorada. 3 trips daily — morning, afternoon, night. From $75/person. All tackle, bait & fishing license included. 65-ft deep-sea vessel.">

  <section class="pt-20 pb-16 px-6 text-center text-white" style="background: linear-gradient(135deg, #0a1628, #1a3a5c);">
    <p class="text-amber-400 text-sm font-semibold uppercase tracking-widest mb-3">Islamorada's Best</p>
    <h1 class="text-4xl md:text-5xl font-bold mb-4" style="font-family: 'Playfair Display', serif;">Captain Michael Party Boat</h1>
    <p class="text-white/70 text-lg max-w-2xl mx-auto">Three trips daily on a fully-rigged 65-ft deep-sea vessel. Bait, tackle, rods & fishing license all included.</p>
  </section>

  <!-- Trip cards -->
  <section class="py-16 px-6">
    <div class="max-w-4xl mx-auto">
      <div class="grid md:grid-cols-3 gap-6 mb-14">
        {trips.map(trip => (
          <div class={`rounded-2xl p-8 text-center border-2 ${trip.highlight ? 'border-amber-400 bg-amber-50' : 'border-gray-200 bg-white'} shadow-sm`}>
            <span class="text-4xl mb-4 block">{trip.icon}</span>
            <p class={`text-xs font-bold uppercase tracking-widest mb-2 ${trip.highlight ? 'text-amber-600' : 'text-gray-500'}`}>{trip.name}</p>
            <p class="text-gray-700 font-medium mb-1">{trip.time}</p>
            <p class="text-3xl font-bold text-gray-900 mb-1">{trip.price}</p>
            <p class="text-gray-400 text-sm mb-6">per person</p>
            <a href={trip.bookLink} target="_blank" rel="noopener"
              class={`block w-full py-2.5 rounded font-semibold text-sm transition-colors ${trip.highlight ? 'bg-amber-500 hover:bg-amber-400 text-white' : 'bg-gray-900 hover:bg-gray-700 text-white'}`}>
              Book This Trip
            </a>
          </div>
        ))}
      </div>

      <!-- What's included -->
      <div class="bg-gray-50 rounded-2xl p-8 mb-10">
        <h2 class="text-xl font-bold text-gray-900 mb-5" style="font-family: 'Playfair Display', serif;">What's Included</h2>
        <div class="grid sm:grid-cols-2 gap-3">
          {[
            '✅ All bait, tackle, and rods',
            '✅ Florida fishing license',
            '✅ Professional, courteous crew',
            '✅ Fish cleaning & filleting at the dock',
            '✅ Shaded cabin & bathrooms onboard',
            '✅ Rotation of the stern',
            '🍽️ Cook your catch at Hungry Tarpon Restaurant',
            'ℹ️ No braided line if bringing your own rod',
          ].map(item => (
            <p class="text-gray-700 text-sm">{item}</p>
          ))}
        </div>
        <p class="text-gray-500 text-xs mt-4 italic">Check in 30 minutes before departure. No prior experience necessary.</p>
      </div>

      <!-- About the boat -->
      <div class="grid md:grid-cols-2 gap-8 items-center">
        <div>
          <h2 class="text-2xl font-bold text-gray-900 mb-4" style="font-family: 'Playfair Display', serif;">What Is Party Boat Fishing?</h2>
          <p class="text-gray-600 leading-relaxed mb-4">Party boat fishing — also called "head boat" fishing — is the most affordable way to experience deep-sea fishing in the Florida Keys. Share the cost with other anglers, get full crew support, and keep everything you catch.</p>
          <p class="text-gray-600 leading-relaxed mb-4">Captain Michael's fully-rigged, 65-ft vessel operates year-round. The professional crew assists beginners and experienced anglers alike — from baiting your hook to netting your fish.</p>
          <p class="text-gray-600 leading-relaxed">After your trip, bring your catch to the <strong>Hungry Tarpon Restaurant</strong> and they'll cook it to your liking — grilled, blackened, fried, or Thai style.</p>
        </div>
        <div class="bg-gradient-to-br from-slate-800 to-blue-900 rounded-2xl p-10 text-center text-white">
          <span class="text-6xl mb-4 block">🎣</span>
          <p class="text-2xl font-bold mb-1">65 Feet</p>
          <p class="text-white/60 text-sm mb-3">Fully-Rigged Deep Sea Vessel</p>
          <p class="text-white/80 text-sm">3 Trips Daily · Year Round</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Private charters CTA -->
  <section class="py-10 px-6 bg-gray-50 border-t border-gray-100">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-gray-700 mb-2 font-medium">Want a private charter instead?</p>
      <p class="text-gray-500 text-sm mb-4">Our booking agents can arrange offshore, backcountry, split charters and more. Call us and we'll set up the trip of a lifetime.</p>
      <a href="tel:3056648070" class="inline-block bg-gray-900 hover:bg-gray-700 text-white px-8 py-3 rounded font-semibold transition-colors">
        📞 Call (305) 664-8070
      </a>
    </div>
  </section>

  <BookingCTA headline="Ready to Reel One In?" subtext="Three party boat trips daily — morning, afternoon, and night." />
</Layout>
