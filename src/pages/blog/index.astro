---
import Layout from '../../layouts/Layout.astro';

const posts = [
  { title: 'Snorkeling vs SNUBA: What\'s the Difference?', href: '/blog/snorkeling-vs-snuba', date: 'March 2026', image: 'https://images.unsplash.com/photo-1544551763-46a013bb70d5?w=600&q=80&auto=format&fit=crop', desc: 'Not sure whether to snorkel or SNUBA on your Florida Keys trip? We break down the differences so you can choose the right underwater adventure.' },
  { title: 'Best Fish to Catch in the Florida Keys in Winter', href: '/blog/best-fish-winter', date: 'March 2026', image: 'https://images.unsplash.com/photo-1501949087-cb1dc00eada1?w=600&q=80&auto=format&fit=crop', desc: 'Winter is prime time for fishing in Islamorada. Here are the species you\'ll be targeting and how to land them.' },
  { title: 'Is Feeding Tarpon Safe?', href: '/blog/is-feeding-tarpon-safe', date: 'March 2026', image: 'https://images.unsplash.com/photo-1559827260-dc66d52bef19?w=600&q=80&auto=format&fit=crop', desc: 'Everything you need to know about safely hand-feeding the Silver Kings at Robbie\'s famous tarpon dock.' },
  { title: 'Reef & Wreck Fishing in the Florida Keys in Winter', href: '/blog/reef-wreck-fishing-winter', date: 'February 2026', image: 'https://images.unsplash.com/photo-1583212292454-1fe6229603b7?w=600&q=80&auto=format&fit=crop', desc: 'The reefs and wrecks of Islamorada offer some of the best fishing in winter. Here\'s what to expect and where to go.' },
  { title: 'Winter Fishing in Islamorada', href: '/blog/winter-fishing-islamorada', date: 'February 2026', image: 'https://images.unsplash.com/photo-1506953823976-52e1fdc0149a?w=600&q=80&auto=format&fit=crop', desc: 'Your complete guide to fishing Islamorada in the winter months — species, techniques, and why now is the best time to go.' },
  { title: 'Top 10 Places to Eat in Islamorada', href: '/blog/top-places-to-eat-islamorada', date: 'February 2026', image: 'https://images.unsplash.com/photo-1514190051997-0f6f39ca5cde?w=600&q=80&auto=format&fit=crop', desc: 'From the Hungry Tarpon to local hidden gems — the best restaurants and dining experiences in Islamorada, FL.' },
  { title: '10 Budget-Friendly Things To Do in Islamorada', href: '/blog/budget-things-to-do-islamorada', date: 'September 2025', image: 'https://images.unsplash.com/photo-1518623489648-a173ef7824f3?w=600&q=80&auto=format&fit=crop', desc: 'Great Keys experiences don\'t have to cost a fortune. Here are 10 affordable activities to add to your Islamorada itinerary.' },
  { title: 'Top 10 Places to Snorkel in Islamorada', href: '/blog/top-places-to-snorkel-islamorada', date: 'September 2025', image: 'https://images.unsplash.com/photo-1544551763-77ef2d0cfc6c?w=600&q=80&auto=format&fit=crop', desc: 'Islamorada has some of the finest snorkeling in the US. Here are the best spots — from Cheeca Rocks to the San Pedro Galleon.' },
];
---

<Layout title="Blog" description="Florida Keys tips, fishing guides, activity comparisons, and local insights from Robbie's Marina of Islamorada.">
  <section class="pt-20 pb-16 px-6 text-center text-white" style="background: linear-gradient(135deg, #0a1628, #1a3a5c);">
    <p class="text-amber-400 text-sm font-semibold uppercase tracking-widest mb-4">Florida Keys Guides</p>
    <h1 class="text-4xl md:text-5xl font-bold mb-6" style="font-family: 'Playfair Display', serif;">From the Dock</h1>
    <p class="text-white/70 text-lg max-w-xl mx-auto">Tips, guides, and local knowledge from the heart of Islamorada.</p>
  </section>

  <section class="py-20 px-6">
    <div class="max-w-6xl mx-auto grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {posts.map(post => (
        <a href={post.href} class="group bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1 border border-gray-100">
          <div class="h-48 overflow-hidden">
            <img src={post.image} alt={post.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
          </div>
          <div class="p-6">
            <p class="text-amber-600 text-xs font-semibold uppercase tracking-widest mb-2">{post.date}</p>
            <h2 class="font-bold text-gray-900 mb-3 text-lg leading-snug group-hover:text-amber-600 transition-colors">{post.title}</h2>
            <p class="text-gray-600 text-sm leading-relaxed">{post.desc}</p>
            <p class="text-amber-600 text-sm font-semibold mt-4">Read More →</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>
