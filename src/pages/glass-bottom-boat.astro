---
import Layout from '../layouts/Layout.astro';
import BookingCTA from '../components/BookingCTA.astro';

const reefs = ['Cheeca Rocks', 'Alligator Reef', 'Caloosa Rocks', 'Islamorada Reef System'];
---

<Layout title="Glass Bottom Boat" description="Best glass bottom boat tour in Islamorada. The 46-foot Transparensea with Seakeeper stabilization. Explore Florida Keys reefs without getting wet.">
  <section class="pt-32 pb-20 px-6 text-center text-white" style="background: linear-gradient(135deg, #0a1a3a, #0d2a5a, #0a3a6a);">
    <p class="text-amber-400 text-sm font-semibold uppercase tracking-widest mb-4">No Snorkel Required</p>
    <h1 class="text-4xl md:text-5xl font-bold mb-6" style="font-family: 'Playfair Display', serif;">Glass Bottom Boat Tours</h1>
    <p class="text-white/70 text-lg max-w-2xl mx-auto">Explore the living reefs of the Florida Keys from the comfort of our stunning 46-foot glass bottom vessel.</p>
  </section>

  <section class="py-20 px-6">
    <div class="max-w-4xl mx-auto">
      <div class="grid md:grid-cols-2 gap-12 items-center mb-16">
        <div>
          <h2 class="text-3xl font-bold text-gray-900 mb-6" style="font-family: 'Playfair Display', serif;">The Transparensea</h2>
          <p class="text-gray-600 leading-relaxed mb-4">A brand new, Seakeeper-stabilized 46-foot glass bottom boat. The smoothest, most stable reef viewing experience in the Florida Keys — perfect for all ages, including those prone to seasickness.</p>
          <p class="text-gray-600 leading-relaxed mb-6">Our educated naturalist guides will narrate everything you see beneath your feet — coral formations, tropical fish, sea turtles, and more.</p>
          <div class="flex flex-wrap gap-3">
            {reefs.map(reef => (
              <span class="bg-blue-50 text-blue-800 px-3 py-1 rounded-full text-sm font-medium">{reef}</span>
            ))}
          </div>
        </div>
        <div class="bg-gradient-to-br from-blue-800 to-cyan-700 rounded-2xl p-12 text-center text-white">
          <span class="text-7xl mb-6 block">🪸</span>
          <p class="text-2xl font-bold mb-2">46 Feet</p>
          <p class="text-white/60">Seakeeper-Stabilized</p>
        </div>
      </div>

      <div class="grid sm:grid-cols-3 gap-6">
        {[
          { emoji: '🔭', label: 'Guided Narration', desc: 'Expert naturalists explain every creature and coral' },
          { emoji: '🌊', label: 'Stay Dry', desc: 'Experience the reef without getting in the water' },
          { emoji: '👨‍👩‍👧‍👦', label: 'Family-Friendly', desc: 'Perfect for all ages — no swimming required' },
        ].map(item => (
          <div class="bg-gray-50 rounded-xl p-6 text-center">
            <span class="text-3xl mb-3 block">{item.emoji}</span>
            <p class="font-semibold text-gray-900 mb-1">{item.label}</p>
            <p class="text-gray-600 text-sm">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <BookingCTA headline="See the Reef Without Getting Wet" subtext="Book your glass bottom boat tour at Robbie's Marina." />
</Layout>
