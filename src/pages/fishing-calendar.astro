---
import Layout from '../layouts/Layout.astro';
import BookingCTA from '../components/BookingCTA.astro';

const calendar = [
  { month: "January", offshore: ["Mahi-Mahi", "Wahoo", "Swordfish", "Kingfish"], reef: ["Yellowtail Snapper", "Grouper", "Amberjack"], flats: ["Bonefish", "Permit", "Redfish"], rating: 4 },
  { month: "February", offshore: ["Mahi-Mahi", "Wahoo", "Sailfish", "Swordfish"], reef: ["Yellowtail Snapper", "Grouper", "Kingfish"], flats: ["Bonefish", "Permit", "Snook"], rating: 4 },
  { month: "March", offshore: ["Sailfish", "Mahi-Mahi", "Wahoo", "Blackfin Tuna"], reef: ["Mutton Snapper", "Grouper", "Cobia"], flats: ["Tarpon begins", "Bonefish", "Permit"], rating: 5 },
  { month: "April", offshore: ["Sailfish", "Mahi-Mahi", "Blackfin Tuna", "Wahoo"], reef: ["Mutton Snapper", "Grouper", "Cobia"], flats: ["Tarpon 🔥", "Bonefish", "Permit"], rating: 5 },
  { month: "May", offshore: ["Mahi-Mahi 🔥", "Sailfish", "Blackfin Tuna"], reef: ["Mutton Snapper", "Grouper", "Amberjack"], flats: ["Tarpon 🔥", "Bonefish", "Permit"], rating: 5 },
  { month: "June", offshore: ["Mahi-Mahi 🔥", "Blackfin Tuna", "Sailfish"], reef: ["Snappers", "Grouper"], flats: ["Tarpon 🔥", "Bonefish", "Permit", "Snook"], rating: 5 },
  { month: "July", offshore: ["Mahi-Mahi", "Blackfin Tuna", "Dolphin"], reef: ["Snappers", "Grouper"], flats: ["Tarpon", "Snook", "Bonefish"], rating: 4 },
  { month: "August", offshore: ["Mahi-Mahi", "Blackfin Tuna", "Swordfish"], reef: ["Snappers", "Grouper"], flats: ["Snook 🔥", "Bonefish", "Tarpon"], rating: 4 },
  { month: "September", offshore: ["Mahi-Mahi", "Swordfish", "Blackfin Tuna"], reef: ["Snappers", "Grouper", "Kingfish"], flats: ["Snook", "Redfish", "Bonefish"], rating: 4 },
  { month: "October", offshore: ["Kingfish 🔥", "Wahoo", "Sailfish", "Mahi-Mahi"], reef: ["Yellowtail Snapper 🔥", "Grouper", "Cobia"], flats: ["Redfish 🔥", "Snook", "Bonefish"], rating: 5 },
  { month: "November", offshore: ["Sailfish 🔥", "Wahoo", "Kingfish", "Swordfish"], reef: ["Yellowtail Snapper", "Grouper", "Amberjack"], flats: ["Bonefish", "Permit", "Redfish"], rating: 5 },
  { month: "December", offshore: ["Sailfish", "Wahoo", "Swordfish", "Kingfish"], reef: ["Yellowtail Snapper", "Grouper", "Amberjack"], flats: ["Bonefish", "Permit", "Redfish"], rating: 4 },
];

const currentMonth = new Date().toLocaleString('en-US', { month: 'long', timeZone: 'America/New_York' });
---

<Layout title="Islamorada Fishing Calendar" description="What's biting in Islamorada right now? Month-by-month fishing calendar for the Florida Keys — offshore, reef, and flats species. Updated for 2026.">

  <section class="pt-20 pb-14 px-6 text-center text-white" style="background: linear-gradient(135deg, #0a1628, #1a3a5c);">
    <p class="text-amber-400 text-sm font-semibold uppercase tracking-widest mb-3">Sport Fishing Capital of the World</p>
    <h1 class="text-4xl md:text-5xl font-bold mb-4" style="font-family: 'Playfair Display', serif;">Islamorada Fishing Calendar</h1>
    <p class="text-white/70 text-lg max-w-2xl mx-auto">What's biting in the Florida Keys every month of the year — offshore, reef & wreck, and flats fishing.</p>
  </section>

  <!-- Current month highlight -->
  {calendar.filter(m => m.month === currentMonth).map(m => (
    <section class="py-8 px-6" style="background-color: #c9a84c;">
      <div class="max-w-5xl mx-auto">
        <div class="flex flex-wrap items-center gap-4">
          <div>
            <p class="text-white font-bold text-lg">🎣 What's Hot in {m.month}</p>
            <p class="text-white/80 text-sm mt-1">Top species right now in Islamorada</p>
          </div>
          <div class="flex flex-wrap gap-2">
            {[...m.offshore.slice(0,3), ...m.flats.slice(0,2)].map(f => (
              <span class="bg-white/20 text-white text-xs font-semibold px-3 py-1.5 rounded-full">{f}</span>
            ))}
          </div>
          <a href="/partyboat" class="ml-auto bg-white text-amber-700 px-5 py-2 rounded font-bold text-sm hover:bg-gray-100 transition-colors whitespace-nowrap">
            Book a Trip
          </a>
        </div>
      </div>
    </section>
  ))}

  <!-- Full calendar -->
  <section class="py-14 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        {calendar.map(m => (
          <div class={`bg-white rounded-2xl border shadow-sm overflow-hidden ${m.month === currentMonth ? 'border-amber-400 ring-2 ring-amber-200' : 'border-gray-100'}`}>
            <div class={`px-5 py-3 flex items-center justify-between ${m.month === currentMonth ? 'bg-amber-500' : 'bg-gray-50 border-b border-gray-100'}`}>
              <h3 class={`font-bold ${m.month === currentMonth ? 'text-white' : 'text-gray-900'}`}>{m.month}</h3>
              <div class="flex gap-0.5">
                {Array.from({length: 5}).map((_, i) => (
                  <span class={`text-sm ${i < m.rating ? (m.month === currentMonth ? 'text-white' : 'text-amber-400') : 'text-gray-200'}`}>★</span>
                ))}
              </div>
            </div>
            <div class="p-5 space-y-4">
              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-blue-600 mb-1.5">🌊 Offshore</p>
                <div class="flex flex-wrap gap-1.5">
                  {m.offshore.map(f => <span class="bg-blue-50 text-blue-700 text-xs px-2 py-0.5 rounded-full">{f}</span>)}
                </div>
              </div>
              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-teal-600 mb-1.5">🪸 Reef & Wreck</p>
                <div class="flex flex-wrap gap-1.5">
                  {m.reef.map(f => <span class="bg-teal-50 text-teal-700 text-xs px-2 py-0.5 rounded-full">{f}</span>)}
                </div>
              </div>
              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-green-600 mb-1.5">🌿 Flats & Backcountry</p>
                <div class="flex flex-wrap gap-1.5">
                  {m.flats.map(f => <span class="bg-green-50 text-green-700 text-xs px-2 py-0.5 rounded-full">{f}</span>)}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-10 bg-gray-50 rounded-2xl p-8 text-center">
        <p class="text-gray-500 text-sm leading-relaxed max-w-2xl mx-auto">Islamorada is home to virtually every species of fish that swims. You can fish somewhere 365 days a year and catch every fish in this hemisphere. <strong>No other destination on earth offers this.</strong></p>
      </div>
    </div>
  </section>

  <BookingCTA headline="Book Your Fishing Trip Today" subtext="3 party boat trips daily with Captain Michael · Private charters available year-round." />
</Layout>
