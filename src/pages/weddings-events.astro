---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Weddings & Events" description="Say 'I do' on Robbie's private beach in Islamorada, Florida Keys. Turquoise water backdrop, catering by Hungry Tarpon, sunset catamaran cruise. Perfect for weddings, rehearsal dinners & private events.">
  <section class="pt-20 pb-20 px-6 text-center text-white" style="background: linear-gradient(135deg, #1a0a2a, #3a1a5a, #2a0a3a);">
    <p class="text-amber-400 text-sm font-semibold uppercase tracking-widest mb-4">Private Beach · Islamorada</p>
    <h1 class="text-4xl md:text-5xl font-bold mb-6" style="font-family: 'Playfair Display', serif;">Weddings & Events</h1>
    <p class="text-white/70 text-lg max-w-2xl mx-auto">Say "I do" on our private beach with turquoise water views of both the Atlantic Ocean and the Gulf of Mexico.</p>
  </section>

  <section class="py-20 px-6">
    <div class="max-w-4xl mx-auto">
      <div class="grid md:grid-cols-2 gap-12 items-center mb-16">
        <div>
          <h2 class="text-3xl font-bold text-gray-900 mb-6" style="font-family: 'Playfair Display', serif;">Crafting Unforgettable Events</h2>
          <p class="text-gray-600 leading-relaxed mb-4">Robbie's "Islamorada Beach" is a private beach tucked away at the west end of Robbie's Marina on Lower Matecumbe Key — offering stunning views of both the Atlantic Ocean and the Gulf of Mexico.</p>
          <p class="text-gray-600 leading-relaxed mb-6">Robbie's strives to make your event memorable, stress-free, and perfect from start to finish. All our flexible wedding and special event packages can be tailored to meet your specific needs.</p>
          <a href="mailto:booth@robbies.com" class="inline-block bg-amber-500 hover:bg-amber-400 text-white px-8 py-3 rounded font-semibold transition-colors">
            Contact Our Event Coordinator
          </a>
        </div>
        <div class="bg-gradient-to-br from-purple-900 to-blue-900 rounded-2xl p-12 text-center text-white">
          <span class="text-6xl mb-4 block">💍</span>
          <p class="text-xl font-bold mb-2">Private Beach</p>
          <p class="text-white/60 text-sm">Lower Matecumbe Key · Islamorada, FL</p>
        </div>
      </div>

      <!-- Event types -->
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
        {[
          { emoji: '💐', title: 'Beach Weddings', desc: 'Intimate ceremonies on the private beach with Atlantic and Gulf views' },
          { emoji: '🥂', title: 'Rehearsal Dinners', desc: 'Waterfront dining crafted by the Hungry Tarpon Restaurant team' },
          { emoji: '🌅', title: 'Sunset Catamaran', desc: 'Post-ceremony cocktail hour aboard the Blue, 120-passenger catamaran' },
          { emoji: '🍽️', title: 'Beach Barbecues', desc: 'Casual catered events for groups of any size on the beach' },
          { emoji: '🎉', title: 'Farewell Brunches', desc: 'Send-off meals crafted to satisfy even the most sophisticated palate' },
          { emoji: '🏢', title: 'Corporate Events', desc: 'Private charters, team-building activities, and catered retreats' },
        ].map(item => (
          <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
            <span class="text-3xl mb-3 block">{item.emoji}</span>
            <h3 class="font-bold text-gray-900 mb-2">{item.title}</h3>
            <p class="text-gray-600 text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>

      <!-- Catamaran highlight -->
      <div class="bg-gray-50 rounded-2xl p-10 text-center">
        <h2 class="text-2xl font-bold text-gray-900 mb-4" style="font-family: 'Playfair Display', serif;">Sail Into Forever</h2>
        <p class="text-gray-600 leading-relaxed max-w-2xl mx-auto mb-6">Once you've said "I do," step onto <em>The Blue</em> — the only 120-passenger, 65-foot catamaran north of Key West — for a cocktail hour and sunset cruise. Your guests will enjoy dazzling oceanic views, the Alligator Reef Lighthouse in the background, and the occasional dolphin escort out into the Atlantic.</p>
        <a href="mailto:booth@robbies.com"
          class="inline-block bg-amber-500 hover:bg-amber-400 text-white px-10 py-4 rounded font-bold text-lg transition-colors shadow-lg">
          Plan Your Event
        </a>
        <p class="text-gray-400 text-sm mt-3">Or call <a href="tel:3056648070" class="underline">305-664-8070</a></p>
      </div>
    </div>
  </section>
</Layout>
