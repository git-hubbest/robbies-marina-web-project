---
import Layout from '../layouts/Layout.astro';
import BookingCTA from '../components/BookingCTA.astro';
---

<Layout title="Sunset Cruises" description="Best sunset cruises in Islamorada at Robbie's Marina. Adults from $49. Three options: catamaran, private deck boat, or luxury 55ft yacht.">
  <section class="pt-20 pb-20 px-6 text-center text-white" style="background: linear-gradient(135deg, #3a0a00, #7a2a00, #c05000);">
    <p class="text-amber-300 text-sm font-semibold uppercase tracking-widest mb-4">Islamorada, Florida Keys</p>
    <h1 class="text-4xl md:text-5xl font-bold mb-6" style="font-family: 'Playfair Display', serif;">Sunset Cruises</h1>
    <p class="text-white/70 text-lg max-w-2xl mx-auto">Three extraordinary ways to end your Florida Keys day — from complimentary champagne on the catamaran to luxury aboard the 55ft Four Aces.</p>
  </section>

  <section class="py-20 px-6">
    <div class="max-w-6xl mx-auto grid md:grid-cols-3 gap-8">

      <!-- Sundance -->
      <div class="bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-shadow border border-gray-100 flex flex-col">
        <div class="bg-gradient-to-br from-orange-700 to-rose-700 h-40 flex items-center justify-center text-6xl">⛵</div>
        <div class="p-8 flex flex-col flex-1">
          <h2 class="text-xl font-bold text-gray-900 mb-1" style="font-family: 'Playfair Display', serif;">Sundance Watersports</h2>
          <p class="text-amber-600 text-sm font-medium mb-1">100+ passenger catamaran</p>
          <div class="flex gap-4 mb-4">
            <span class="bg-amber-50 text-amber-800 text-sm font-semibold px-3 py-1 rounded-full">Adult $49</span>
            <span class="bg-amber-50 text-amber-800 text-sm font-semibold px-3 py-1 rounded-full">Child $39</span>
          </div>
          <p class="text-gray-600 text-sm leading-relaxed mb-4">Florida Bay cruise with complimentary champagne. Beer & wine available. Wed, Fri & Sat departures. Private charters for weddings and large events.</p>
          <ul class="space-y-1 text-sm text-gray-700 mb-6 flex-1">
            {['Complimentary champagne', 'Beer & wine available', 'Wed, Fri & Sat departures', 'Private event charters'].map(f => (
              <li class="flex items-center gap-2"><span class="text-amber-500">✓</span> {f}</li>
            ))}
          </ul>
          <a href="https://fareharbor.com/embeds/book/sundancewatersports/?full-items=yes" target="_blank" rel="noopener"
            class="block w-full bg-amber-500 hover:bg-amber-400 text-white text-center px-6 py-3 rounded font-semibold transition-colors">
            Book Now
          </a>
        </div>
      </div>

      <!-- KeyZ -->
      <div class="bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-shadow border border-gray-100 flex flex-col">
        <div class="bg-gradient-to-br from-amber-700 to-orange-600 h-40 flex items-center justify-center text-6xl">🌅</div>
        <div class="p-8 flex flex-col flex-1">
          <h2 class="text-xl font-bold text-gray-900 mb-1" style="font-family: 'Playfair Display', serif;">KeyZ Charters</h2>
          <p class="text-amber-600 text-sm font-medium mb-4">Captain Sam's 21' deck boat · Private</p>
          <p class="text-gray-600 text-sm leading-relaxed mb-4">Fully private and fully customizable. Watch the sunset, explore the mangroves, snorkel the reef, or party on the sandbar. Landmarks: Indian Key, Lignumvitae Key, Alligator Lighthouse.</p>
          <ul class="space-y-1 text-sm text-gray-700 mb-6 flex-1">
            {['Fully private charter', 'Custom destination & activities', 'Catered picnic option', 'Birthday & anniversary packages', 'Eco-tours & snorkel combos'].map(f => (
              <li class="flex items-center gap-2"><span class="text-amber-500">✓</span> {f}</li>
            ))}
          </ul>
          <a href="https://checkout.xola.com/index.html#seller/5dfba093261bf132b2490b52" target="_blank" rel="noopener"
            class="block w-full bg-amber-500 hover:bg-amber-400 text-white text-center px-6 py-3 rounded font-semibold transition-colors">
            Book Now
          </a>
        </div>
      </div>

      <!-- Four Aces -->
      <div class="bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-shadow border border-gray-100 flex flex-col">
        <div class="bg-gradient-to-br from-slate-800 to-blue-900 h-40 flex items-center justify-center text-6xl">🛥️</div>
        <div class="p-8 flex flex-col flex-1">
          <h2 class="text-xl font-bold text-gray-900 mb-1" style="font-family: 'Playfair Display', serif;">Four Aces</h2>
          <p class="text-amber-600 text-sm font-medium mb-1">55' Hatteras luxury yacht</p>
          <div class="mb-4">
            <span class="bg-slate-100 text-slate-800 text-sm font-semibold px-3 py-1 rounded-full">From $1,000 · 1.5 hrs</span>
          </div>
          <p class="text-gray-600 text-sm leading-relaxed mb-4">The pinnacle of Keys luxury. Mimosas included from the bar. Bottle service available. Food can be pre-ordered from Hungry Tarpon. Departs 7 days a week.</p>
          <ul class="space-y-1 text-sm text-gray-700 mb-6 flex-1">
            {['Mimosas included', 'Bottle service available', '7 days a week', 'Up to 6 guests (USCG)', 'Bahamas & Dry Tortugas capable'].map(f => (
              <li class="flex items-center gap-2"><span class="text-amber-500">✓</span> {f}</li>
            ))}
          </ul>
          <a href="https://fareharbor.com/embeds/book/robbies/items/420234/calendar/?flow=13390&full-items=yes" target="_blank" rel="noopener"
            class="block w-full bg-amber-500 hover:bg-amber-400 text-white text-center px-6 py-3 rounded font-semibold transition-colors">
            Book Now
          </a>
          <p class="text-center text-gray-400 text-xs mt-2">Booking &lt;24hrs? Call <a href="tel:3056648070" class="underline">305-664-8070</a></p>
        </div>
      </div>

    </div>
  </section>

  <BookingCTA headline="Watch the Sun Sink into the Keys" subtext="Book your sunset cruise at Robbie's Marina." />
</Layout>
