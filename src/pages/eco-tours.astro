---
import Layout from '../layouts/Layout.astro';
import BookingCTA from '../components/BookingCTA.astro';
---

<Layout title="Eco Tours" description="Eco tours at Robbie's Marina. 2-hour Florida Bay expeditions through mangrove islands, sea grass beds, and abundant wildlife.">
  <section class="pt-32 pb-20 px-6 text-center text-white" style="background: linear-gradient(135deg, #0a2a0a, #1a4a1a, #0d3a0d);">
    <p class="text-amber-400 text-sm font-semibold uppercase tracking-widest mb-4">Florida Bay</p>
    <h1 class="text-4xl md:text-5xl font-bold mb-6" style="font-family: 'Playfair Display', serif;">Eco Tours</h1>
    <p class="text-white/70 text-lg max-w-2xl mx-auto">Two-hour expeditions into the raw beauty of Florida Bay — mangrove islands, sea grass beds, and extraordinary wildlife.</p>
  </section>

  <section class="py-20 px-6">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-gray-600 text-lg leading-relaxed mb-12">Robbie's Eco-Tours take you on an excursion through passages among sea grass beds that rim the many protected shallow bays. We navigate among hundreds of small, uninhabited mangrove and hardwood hammock islands — home to an amazing variety of wildlife.</p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
        {[
          { emoji: '🐦', label: 'Rare Birds' },
          { emoji: '🐊', label: 'Wildlife' },
          { emoji: '🌿', label: 'Mangroves' },
          { emoji: '🏝️', label: 'Uninhabited Islands' },
        ].map(item => (
          <div class="bg-green-50 rounded-xl p-6 text-center">
            <span class="text-4xl mb-3 block">{item.emoji}</span>
            <p class="font-semibold text-gray-900">{item.label}</p>
          </div>
        ))}
      </div>
      <div class="bg-gray-50 rounded-xl p-6 text-left">
        <p class="font-semibold text-gray-800 mb-2">⏱ Tour Details</p>
        <p class="text-gray-600 text-sm">Duration: 2 hours | Departs from Robbie's Marina dock | All ages welcome | No experience required</p>
      </div>
    </div>
  </section>

  <BookingCTA headline="Explore Florida Bay's Hidden World" subtext="Book your eco tour at Robbie's Marina." />
</Layout>
