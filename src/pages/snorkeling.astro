---
import Layout from '../layouts/Layout.astro';
import BookingCTA from '../components/BookingCTA.astro';
---

<Layout title="Snorkeling" description="Best snorkeling in Islamorada at Robbie's Marina. Daily trips at 10am & 1:30pm. Adults $65, Children $55. Gear included.">
  <section class="pt-32 pb-20 px-6 text-center text-white" style="background: linear-gradient(135deg, #0a2a3a, #0d4a6b);">
    <p class="text-amber-400 text-sm font-semibold uppercase tracking-widest mb-4">Florida Keys</p>
    <h1 class="text-4xl md:text-5xl font-bold mb-6" style="font-family: 'Playfair Display', serif;">Snorkeling Tours</h1>
    <p class="text-white/70 text-lg max-w-2xl mx-auto">Dive into the stunning underwater world of the Florida Keys. Snorkel gear included — just show up and jump in.</p>
  </section>

  <!-- Rates -->
  <section class="py-12 px-6 bg-amber-50 border-b border-amber-100">
    <div class="max-w-3xl mx-auto">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
        {[
          { label: 'Adult Snorkel', price: '$65' },
          { label: 'Child (12 & under)', price: '$55' },
          { label: 'Ride Along', price: '$55' },
          { label: 'Children 3 & under', price: 'FREE' },
        ].map(r => (
          <div class="bg-white rounded-xl p-4 shadow-sm">
            <p class="text-2xl font-bold text-amber-600 mb-1">{r.price}</p>
            <p class="text-gray-600 text-sm">{r.label}</p>
          </div>
        ))}
      </div>
      <p class="text-center text-gray-500 text-sm mt-4">Snorkel gear included · Duration: 2.5 hours</p>
    </div>
  </section>

  <!-- Departure Times -->
  <section class="py-6 px-6" style="background-color: #0a1628;">
    <div class="max-w-2xl mx-auto flex flex-col sm:flex-row gap-4 justify-center text-center">
      <div class="flex-1 border border-white/20 rounded-lg p-4">
        <p class="text-amber-400 font-semibold text-sm uppercase tracking-widest mb-1">Morning Trip</p>
        <p class="text-white font-bold text-lg">10:00am → 12:30pm</p>
      </div>
      <div class="flex-1 border border-white/20 rounded-lg p-4">
        <p class="text-amber-400 font-semibold text-sm uppercase tracking-widest mb-1">Afternoon Trip</p>
        <p class="text-white font-bold text-lg">1:30pm → 4:00pm</p>
      </div>
    </div>
  </section>

  <section class="py-20 px-6">
    <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-12">
      <!-- Sundance -->
      <div class="bg-white border border-gray-100 rounded-2xl p-10 shadow-sm">
        <span class="text-5xl mb-6 block">🚢</span>
        <h2 class="text-2xl font-bold text-gray-900 mb-2" style="font-family: 'Playfair Display', serif;">Sundance Watersports — The Blue</h2>
        <p class="text-amber-600 text-sm font-medium mb-4">Daily departures · 100-passenger catamaran</p>
        <p class="text-gray-600 mb-6 leading-relaxed">Built in South Florida and designed for Keys adventures. Two outdoor showers, full-sized bathroom/changing room. Also available for private charters, corporate retreats, and wedding parties. Sunset cruises Wed, Fri & Sat.</p>
        <ul class="space-y-2 text-sm text-gray-700 mb-8">
          {['Snorkel gear included', 'Two outdoor showers onboard', 'Full bathroom & changing room', 'Private charters available', '5-star TripAdvisor rated'].map(f => (
            <li class="flex items-center gap-2"><span class="text-amber-500">✓</span> {f}</li>
          ))}
        </ul>
        <a href="https://fareharbor.com/embeds/book/sundancewatersports/items/22988/calendar/?flow=17252&full-items=yes" target="_blank" rel="noopener"
          class="block w-full bg-amber-500 hover:bg-amber-400 text-white text-center px-6 py-3 rounded font-semibold transition-colors">
          Book Sundance Watersports
        </a>
      </div>

      <!-- KeyZ -->
      <div class="bg-white border border-gray-100 rounded-2xl p-10 shadow-sm">
        <span class="text-5xl mb-6 block">⛵</span>
        <h2 class="text-2xl font-bold text-gray-900 mb-2" style="font-family: 'Playfair Display', serif;">KeyZ Charters</h2>
        <p class="text-amber-600 text-sm font-medium mb-4">Private · Groups of 6 or fewer</p>
        <p class="text-gray-600 mb-6 leading-relaxed">The intimate Keys snorkel experience. Captain Sam tailors every trip to your group — snorkel the offshore reef, explore the mangroves, or combine activities for a custom adventure.</p>
        <ul class="space-y-2 text-sm text-gray-700 mb-8">
          {['Fully private charter', 'Custom itinerary', 'Max 6 guests', 'Eco-tours & sunset combos available', 'Birthday & anniversary packages'].map(f => (
            <li class="flex items-center gap-2"><span class="text-amber-500">✓</span> {f}</li>
          ))}
        </ul>
        <a href="https://checkout.xola.app/index.html#seller/5dfba093261bf132b2490b52?openExternal=true" target="_blank" rel="noopener"
          class="block w-full bg-amber-500 hover:bg-amber-400 text-white text-center px-6 py-3 rounded font-semibold transition-colors">
          Book KeyZ Charters
        </a>
      </div>
    </div>
  </section>

  <section class="py-16 px-6 bg-gray-50">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-2xl font-bold text-gray-900 mb-10" style="font-family: 'Playfair Display', serif;">What to Expect</h2>
      <div class="grid sm:grid-cols-3 gap-6">
        {[
          { emoji: '🐠', label: 'Vibrant Marine Life', desc: 'Cheeca Rocks, Alligator Reef & more' },
          { emoji: '👨‍👩‍👧', label: 'All Ages Welcome', desc: 'Kids 3 & under ride free' },
          { emoji: '🎓', label: 'Expert Guides', desc: 'Marine science-educated naturalists' },
        ].map(item => (
          <div class="text-center">
            <span class="text-4xl mb-3 block">{item.emoji}</span>
            <p class="font-semibold text-gray-900 mb-1">{item.label}</p>
            <p class="text-gray-600 text-sm">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <BookingCTA headline="Dive Into the Florida Keys" subtext="Book your snorkel tour at Robbie's Marina today." />
</Layout>
