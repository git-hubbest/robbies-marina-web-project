  ],
  handheld: [
    { name: 'Mahi Sandwich', desc: 'Grilled, blackened, or fried; lettuce, tomato, onion, salted pretzel bun' },
    { name: 'Grouper Sandwich', desc: 'Grilled, blackened, or fried; lettuce, tomato, onion, salted pretzel bun' },
    { name: 'Salmon BLT', desc: 'Arugula, tomato, roasted red pepper aioli, salted pretzel bun' },
    { name: 'BBQ Short Rib Sandwich', desc: 'Guinness braised short rib, house BBQ sauce, pepper jack cheese, bacon, sliced tomato, sautéed onions on griddled sourdough' },
    { name: 'Philly Cheesesteak', desc: 'Shaved ribeye, amoroso bun; wiz wit or wiz wit out' },
    { name: 'Mahi Reuben', desc: 'Swiss cheese, 1000 island, cole slaw, griddled rye' },
    { name: 'Fish Tacos Sandwich', desc: 'Grilled, blackened, or fried; cheddar jack, pico de gallo, avocado, salted pretzel bun' },
    { name: 'Crunchy Grouper Hoagie', desc: 'Cornflake grouper, lettuce, tomato, roasted red pepper aioli, toasted hoagie roll' },
    { name: 'Smash Burger', desc: 'Blend of short rib, brisket, and ground chuck; lettuce, tomato, onion, pickle spear, salted pretzel bun' },
    { name: 'BBQ Bacon Burger', desc: 'Melted cheddar jack, applewood smoked bacon, house made BBQ sauce, sautéed onion, salted pretzel bun' },
  ],
  entrees: [
    { name: 'Cajun Chicken Pasta', desc: 'Sautéed red onions, tomatoes, mushrooms, chorizo, cavatappi pasta in a cheesy cajun cream sauce, topped with crispy chicken and basil' },
    { name: 'Grilled Mahi', desc: 'Yellow rice, black beans, fried plantains, chimichurri' },
    { name: 'Seafood Paella', desc: 'Mussels, shrimp, mahi mahi, tomatoes, red peppers, onions, chorizo, cajun butter tomato sauce; over yellow rice' },
