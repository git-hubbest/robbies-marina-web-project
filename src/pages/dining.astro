<script>
  const tabs = document.querySelectorAll('.menu-tab');
  const contents = document.querySelectorAll('.menu-content');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const idx = tab.getAttribute('data-tab');
      tabs.forEach(t => {
        t.classList.remove('bg-amber-500', 'text-white');
        t.classList.add('bg-white', 'text-gray-700', 'border', 'border-gray-200');
      });
      tab.classList.add('bg-amber-500', 'text-white');
      tab.classList.remove('bg-white', 'text-gray-700', 'border', 'border-gray-200');
      contents.forEach(c => c.classList.add('hidden'));
      document.querySelector(`[data-content="${idx}"]`)?.classList.remove('hidden');
    });
  });
</script>
