    { name: 'Panko Crusted Crab Cake', desc: 'Panko-crusted, fried, topped with lemon aioli, thai chile sauce, and scallions' },
    { name: 'Stone Crab Claws', desc: 'Key lime mustard sauce — Oct 15 – May 1 (seasonal)' },
  ],
  salads: [
    { name: 'Caesar Salad', desc: 'Romaine hearts, croutons, shaved parmesan, creamy caesar dressing' },
    { name: 'Strawberry Fields', desc: 'Mixed greens, strawberries, mandarin oranges, red onion, cucumber, toasted almonds, strawberry vinaigrette' },
    { name: 'Caprese Salad', desc: 'Fresh sliced mozzarella, tomato, olive oil, balsamic glaze, basil chiffonade over arugula' },
