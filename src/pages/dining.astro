    { name: 'Island Tea', desc: 'Sweet tea vodka, lemonade, splash of champagne' },
  ],
  bloodymary: { name: 'Trailer Trash Bloody Mary', desc: 'Our legendary loaded Bloody Mary — bleu cheese, pickle & pimento stuffed olives, pickled green bean, celery, crispy bacon strip, cocktail shrimp, meat straw. Voted best Upper Keys Bloody Mary.' },
  frozens: ['Piña Colada', 'Rum Runner', 'Pain in the Ass', 'Miami Vice', 'Key Lime Colada'],
  mojitos: ['Classic', 'Strawberry', 'Blueberry', 'Mango'],
  margaritas: ['Classic', 'Strawberry & Jalapeño', 'Cucumber & Jalapeño', 'Pineapple & Vanilla', 'Mango'],
  drafts: ['Beach Blonde Ale', 'Stella Artois', 'Yuengling', 'Seasonal Draft', 'Seasonal Cider', 'Honey Hibiscus Kölsch', 'American Amber Ale'],
};

const desserts = [
  { name: 'Key Lime Pie', desc: 'Graham cracker crust, white chocolate & raspberry sauces, lime zest, pastry cream' },
  { name: "S'Mores Brownie", desc: 'Toasted homemade marshmallow fluff, graham crackers' },
  { name: 'Piña Colada Cake', desc: 'Vanilla rum glaze, whipped pastry cream, sweet and spicy pecans' },
  { name: 'Bananas Foster', desc: 'Spiced rum glazed bananas foster, caramel & raspberry sauces, vanilla ice cream' },
  { name: 'Dulce De Leche Cheesecake', desc: 'Graham cracker crust, caramel sauce, white chocolate shavings, pink himalayan sea salt, pastry cream' },
  { name: 'Donut Sundae', desc: 'Warm glazed donuts, scoops of vanilla ice cream, sprinkles, toasted almonds, chocolate chips, mini marshmallows, sliced strawberries, white chocolate and caramel sauces, pastry cream and maraschino cherries' },
];

const photos = [
  { src: '/img/trivia-night.webp', alt: 'Waterfront dining' },
  { src: '/img/beach.webp', alt: 'Signature cocktails' },
  { src: '/img/snorkeling.webp', alt: 'Fresh seafood' },
  { src: '/img/feed-tarpon.webp', alt: 'Breakfast at the dock' },
  { src: '/img/captain-michael.webp', alt: 'Fresh catch' },
  { src: '/img/history-brad.webp', alt: 'Bloody Mary' },
];
---

<Layout title="Hungry Tarpon Restaurant & Bar" description="Waterfront dining at Robbie's Marina of Islamorada. Fresh Florida Keys seafood, signature cocktails, the legendary Trailer Trash Bloody Mary. Open daily 6:30am–9pm.">

  <!-- Hero -->
  <section class="relative h-80 md:h-96 flex items-end overflow-hidden">
    <img
      src="/img/trivia-night.webp"
      alt="Hungry Tarpon Restaurant waterfront dining"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(10,22,40,0.85) 0%, rgba(10,22,40,0.2) 60%, transparent 100%);"></div>
    <div class="relative z-10 w-full max-w-5xl mx-auto px-6 pb-10">
      <p class="text-amber-400 text-sm font-semibold uppercase tracking-widest mb-2">Robbie's Marina · Islamorada</p>
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-2" style="font-family: 'Playfair Display', serif;">Hungry Tarpon Restaurant</h1>
      <p class="text-white/80">Open Daily · 6:30am – 9:00pm · Waterfront Deck · (305) 664-0535</p>
    </div>
  </section>

  <!-- Quick info bar -->
  <section class="py-4 px-6 bg-amber-500">
    <div class="max-w-5xl mx-auto flex flex-wrap justify-center gap-6 text-white text-sm font-semibold">
      <span>🕐 Mon–Sat Breakfast 6:30am–10:30am · Sun until 11am</span>
      <span>🍽️ Lunch & Dinner Mon–Sun 6:30am–9pm</span>
      <span>📞 (305) 664-0535</span>
      <a href="https://311i00301793492.s4shops.com/giftcard.html" target="_blank" rel="noopener" class="underline hover:no-underline">🎁 Gift Cards</a>
    </div>
  </section>

  <!-- Photo grid -->
  <section class="py-12 px-6 bg-gray-50">
    <div class="max-w-6xl mx-auto grid grid-cols-2 md:grid-cols-3 gap-3">
      {photos.map(p => (
        <div class="aspect-square overflow-hidden rounded-xl">
          <img src={p.src} alt={p.alt} class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" loading="lazy" />
        </div>
      ))}
    </div>
  </section>

  <!-- Signature dishes callout -->
  <section class="py-16 px-6">
    <div class="max-w-5xl mx-auto text-center mb-12">
      <p class="text-amber-600 text-sm font-semibold uppercase tracking-widest mb-3">Must Try</p>
      <h2 class="text-3xl font-bold text-gray-900" style="font-family: 'Playfair Display', serif;">Signature Dishes</h2>
    </div>
    <div class="max-w-5xl mx-auto grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {[
        { name: 'Trailer Trash Bloody Mary', desc: 'Our legendary loaded Bloody Mary — voted best in the Upper Keys', emoji: '🍅' },
        { name: 'Lobster Mac & Cheese', desc: 'Broiled lobster tail, cavatappi pasta, parmesan cream sauce', emoji: '🦞' },
        { name: 'Lemongrass Ribs', desc: 'Slow roasted Asian spiced ribs, ginger sesame slaw', emoji: '🍖' },
        { name: 'Key Lime Pie', desc: 'Graham cracker crust, white chocolate & raspberry, lime zest', emoji: '🥧' },
      ].map(dish => (
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 text-center">
          <span class="text-5xl mb-4 block">{dish.emoji}</span>
          <h3 class="font-bold text-gray-900 mb-2">{dish.name}</h3>
          <p class="text-gray-600 text-sm">{dish.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- MENU TABS -->
  <section class="py-16 px-6 bg-gray-50" id="menu">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-10">
        <p class="text-amber-600 text-sm font-semibold uppercase tracking-widest mb-3">Hungry Tarpon Restaurant</p>
        <h2 class="text-3xl font-bold text-gray-900" style="font-family: 'Playfair Display', serif;">Our Menu</h2>
      </div>

      <!-- Tab buttons -->
      <div class="flex flex-wrap gap-2 justify-center mb-10" id="menu-tabs">
        {menuTabs.map((tab, i) => (
          <button
            class={`menu-tab px-5 py-2 rounded-full text-sm font-semibold transition-colors ${i === 0 ? 'bg-amber-500 text-white' : 'bg-white text-gray-700 border border-gray-200 hover:border-amber-400'}`}
            data-tab={i}
          >
            {tab}
          </button>
        ))}
      </div>

      <!-- BREAKFAST TAB -->
      <div class="menu-content" data-content="0">
        <div class="grid md:grid-cols-2 gap-8">
          <div>
            <h3 class="text-lg font-bold text-gray-900 mb-4 pb-2 border-b border-gray-200">Hungry Tarpon Specials</h3>
            <div class="space-y-3">
              {breakfast.specials.map(item => (
                <div class="flex gap-3">
                  <div class="w-1.5 h-1.5 rounded-full bg-amber-400 mt-2 flex-shrink-0"></div>
                  <div><p class="font-semibold text-gray-900 text-sm">{item.name}</p><p class="text-gray-500 text-xs mt-0.5">{item.desc}</p></div>
                </div>
              ))}
            </div>

            <h3 class="text-lg font-bold text-gray-900 mt-8 mb-4 pb-2 border-b border-gray-200">Scrambled Egg Skillets</h3>
            <div class="space-y-3">
              {breakfast.skillets.map(item => (
                <div class="flex gap-3">
                  <div class="w-1.5 h-1.5 rounded-full bg-amber-400 mt-2 flex-shrink-0"></div>
                  <div><p class="font-semibold text-gray-900 text-sm">{item.name}</p><p class="text-gray-500 text-xs mt-0.5">{item.desc}</p></div>
                </div>
              ))}
            </div>

            <h3 class="text-lg font-bold text-gray-900 mt-8 mb-4 pb-2 border-b border-gray-200">Croissant Benedicts</h3>
            <div class="space-y-3">
              {breakfast.benedicts.map(item => (
                <div class="flex gap-3">
                  <div class="w-1.5 h-1.5 rounded-full bg-amber-400 mt-2 flex-shrink-0"></div>
                  <div><p class="font-semibold text-gray-900 text-sm">{item.name}</p><p class="text-gray-500 text-xs mt-0.5">{item.desc}</p></div>
                </div>
              ))}
            </div>
          </div>

          <div>
            <h3 class="text-lg font-bold text-gray-900 mb-4 pb-2 border-b border-gray-200">Omelettes</h3>
            <p class="text-xs text-gray-500 mb-3 italic">All served with home fries or cheddar scallion hash browns, and toast. Egg whites +$1.95 · Lobster +$8.95</p>
            <div class="space-y-3">
              {breakfast.omelettes.map(item => (
                <div class="flex gap-3">
                  <div class="w-1.5 h-1.5 rounded-full bg-amber-400 mt-2 flex-shrink-0"></div>
                  <div><p class="font-semibold text-gray-900 text-sm">{item.name}</p><p class="text-gray-500 text-xs mt-0.5">{item.desc}</p></div>
                </div>
              ))}
            </div>

            <h3 class="text-lg font-bold text-gray-900 mt-8 mb-4 pb-2 border-b border-gray-200">Hand-Helds</h3>
            <p class="text-xs text-gray-500 mb-3 italic">All sandwiches served with home fries or cheddar scallion hash browns</p>
            <div class="space-y-3">
              {breakfast.handheld.map(item => (
                <div class="flex gap-3">
                  <div class="w-1.5 h-1.5 rounded-full bg-amber-400 mt-2 flex-shrink-0"></div>
                  <div><p class="font-semibold text-gray-900 text-sm">{item.name}</p><p class="text-gray-500 text-xs mt-0.5">{item.desc}</p></div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- LUNCH & DINNER TAB -->
      <div class="menu-content hidden" data-content="1">
        <div class="grid md:grid-cols-2 gap-8">
          <div>
            <h3 class="text-lg font-bold text-gray-900 mb-4 pb-2 border-b border-gray-200">Appetizers</h3>
            <div class="space-y-3">
              {lunchDinner.appetizers.map(item => (
                <div class="flex gap-3">
                  <div class="w-1.5 h-1.5 rounded-full bg-amber-400 mt-2 flex-shrink-0"></div>
                  <div><p class="font-semibold text-gray-900 text-sm">{item.name}</p><p class="text-gray-500 text-xs mt-0.5">{item.desc}</p></div>
                </div>
              ))}
            </div>

            <h3 class="text-lg font-bold text-gray-900 mt-8 mb-4 pb-2 border-b border-gray-200">Soups & Salads</h3>
            <div class="space-y-3">
              {lunchDinner.salads.map(item => (
                <div class="flex gap-3">
                  <div class="w-1.5 h-1.5 rounded-full bg-amber-400 mt-2 flex-shrink-0"></div>
                  <div><p class="font-semibold text-gray-900 text-sm">{item.name}</p><p class="text-gray-500 text-xs mt-0.5">{item.desc}</p></div>
                </div>
              ))}
            </div>
            <p class="text-xs text-gray-500 mt-2 italic">Add protein: Chicken $8.95 · Shrimp $11.95 · Mahi $12.95 · Grouper $13.95 · Salmon $18.95 · Tuna $16.95</p>
          </div>

          <div>
            <h3 class="text-lg font-bold text-gray-900 mb-4 pb-2 border-b border-gray-200">Hand-Helds</h3>
            <div class="space-y-3">
              {lunchDinner.handheld.map(item => (
                <div class="flex gap-3">
                  <div class="w-1.5 h-1.5 rounded-full bg-amber-400 mt-2 flex-shrink-0"></div>
                  <div><p class="font-semibold text-gray-900 text-sm">{item.name}</p><p class="text-gray-500 text-xs mt-0.5">{item.desc}</p></div>
                </div>
              ))}
            </div>

            <h3 class="text-lg font-bold text-gray-900 mt-8 mb-4 pb-2 border-b border-gray-200">Entrees</h3>
            <div class="space-y-3">
              {lunchDinner.entrees.map(item => (
                <div class="flex gap-3">
                  <div class="w-1.5 h-1.5 rounded-full bg-amber-400 mt-2 flex-shrink-0"></div>
                  <div><p class="font-semibold text-gray-900 text-sm">{item.name}</p><p class="text-gray-500 text-xs mt-0.5">{item.desc}</p></div>
                </div>
              ))}
            </div>

            <div class="mt-8 bg-amber-50 rounded-xl p-5 border border-amber-200">
              <h3 class="font-bold text-amber-900 mb-2">🎣 {lunchDinner.hookAndCook.name}</h3>
              <p class="text-amber-800 text-sm">{lunchDinner.hookAndCook.desc}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- COCKTAILS TAB -->
      <div class="menu-content hidden" data-content="2">
        <!-- Bloody Mary feature -->
        <div class="bg-red-50 border border-red-100 rounded-2xl p-8 mb-8 flex gap-6 items-center">
          <span class="text-6xl flex-shrink-0">🍅</span>
          <div>
            <h3 class="text-xl font-bold text-red-900 mb-2" style="font-family: 'Playfair Display', serif;">{cocktails.bloodymary.name}</h3>
            <p class="text-red-800 leading-relaxed">{cocktails.bloodymary.desc}</p>
          </div>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          <div>
            <h3 class="text-lg font-bold text-gray-900 mb-4 pb-2 border-b border-gray-200">Signature Cocktails</h3>
            <div class="space-y-3">
              {cocktails.signatures.map(item => (
                <div class="flex gap-3">
                  <div class="w-1.5 h-1.5 rounded-full bg-amber-400 mt-2 flex-shrink-0"></div>
                  <div><p class="font-semibold text-gray-900 text-sm">{item.name}</p><p class="text-gray-500 text-xs mt-0.5">{item.desc}</p></div>
                </div>
              ))}
            </div>

            <h3 class="text-lg font-bold text-gray-900 mt-8 mb-4 pb-2 border-b border-gray-200">Frozens</h3>
            <div class="flex flex-wrap gap-2">
              {cocktails.frozens.map(f => <span class="bg-blue-50 text-blue-800 text-xs px-3 py-1.5 rounded-full font-medium">{f}</span>)}
            </div>

            <h3 class="text-lg font-bold text-gray-900 mt-6 mb-4 pb-2 border-b border-gray-200">Mojitos</h3>
            <div class="flex flex-wrap gap-2">
              {cocktails.mojitos.map(m => <span class="bg-green-50 text-green-800 text-xs px-3 py-1.5 rounded-full font-medium">{m}</span>)}
            </div>

            <h3 class="text-lg font-bold text-gray-900 mt-6 mb-4 pb-2 border-b border-gray-200">Margaritas</h3>
            <div class="flex flex-wrap gap-2">
              {cocktails.margaritas.map(m => <span class="bg-yellow-50 text-yellow-800 text-xs px-3 py-1.5 rounded-full font-medium">{m}</span>)}
            </div>
          </div>

          <div>
            <h3 class="text-lg font-bold text-gray-900 mb-4 pb-2 border-b border-gray-200">Draft Beer</h3>
            <div class="space-y-2">
              {cocktails.drafts.map(d => (
                <div class="flex gap-3 items-center">
                  <span class="text-amber-500">🍺</span>
                  <p class="text-gray-700 text-sm">{d}</p>
                </div>
              ))}
            </div>

