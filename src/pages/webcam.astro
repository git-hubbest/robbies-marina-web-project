---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Live Webcam — Islamorada" description="Watch the live webcam from Robbie's Marina of Islamorada. See the tarpon feeding dock, marina, and underwater live stream in real time.">

  <section class="pt-20 pb-10 px-6 text-center text-white" style="background: linear-gradient(135deg, #0a1628, #1a3a5c);">
    <p class="text-amber-400 text-sm font-semibold uppercase tracking-widest mb-3">Live from Islamorada</p>
    <h1 class="text-4xl md:text-5xl font-bold mb-4" style="font-family: 'Playfair Display', serif;">Live Webcam</h1>
    <p class="text-white/70 text-lg max-w-xl mx-auto">See what's happening at Robbie's Marina right now — dock, tarpon, and underwater.</p>
  </section>

  <section class="py-12 px-6">
    <div class="max-w-5xl mx-auto space-y-10">

      <!-- Dock cam -->
      <div>
        <h2 class="text-xl font-bold text-gray-900 mb-4" style="font-family: 'Playfair Display', serif;">🎥 Dock Webcam — Live</h2>
        <div class="rounded-2xl overflow-hidden shadow-lg bg-black aspect-video">
          <iframe
            src="https://www.youtube.com/embed/live_stream?channel=UC87uKTXV7je0G6h3eUqMaNQ&autoplay=1&mute=1"
            class="w-full h-full"
            allowfullscreen
            allow="autoplay; encrypted-media"
            title="Robbie's Marina Live Webcam"
          ></iframe>
        </div>
        <div class="mt-3 flex items-center justify-between">
          <p class="text-gray-500 text-sm">🔴 Live from Robbie's of Islamorada</p>
          <a href="https://www.youtube.com/@RobbiesIslamorada/streams" target="_blank" rel="noopener"
            class="text-blue-600 hover:underline text-sm font-semibold">Watch on YouTube →</a>
        </div>
      </div>

      <!-- Underwater cam -->
      <div>
        <h2 class="text-xl font-bold text-gray-900 mb-2" style="font-family: 'Playfair Display', serif;">🐟 Underwater Dock Cam</h2>
        <p class="text-gray-600 text-sm mb-4">Watch the tarpon and marine life beneath the dock in real time.</p>
        <div class="rounded-2xl overflow-hidden shadow-lg bg-black aspect-video">
          <iframe
            src="https://www.youtube.com/embed/live_stream?channel=UC87uKTXV7je0G6h3eUqMaNQ&autoplay=1&mute=1"
            class="w-full h-full"
            allowfullscreen
            allow="autoplay; encrypted-media"
            title="Robbie's Marina Underwater Webcam"
          ></iframe>
        </div>
      </div>

      <!-- CTA -->
      <div class="bg-gray-50 rounded-2xl p-8 text-center border border-gray-100">
        <p class="text-gray-700 font-medium mb-2">Like what you see? Come visit us in person.</p>
        <p class="text-gray-500 text-sm mb-4">77522 Overseas Hwy, Islamorada FL · Open Daily 7am–9pm</p>
        <div class="flex flex-wrap gap-3 justify-center">
          <a href="/activities" class="bg-amber-500 hover:bg-amber-400 text-white px-6 py-2.5 rounded font-semibold text-sm transition-colors">Explore Activities</a>
          <a href="https://www.google.com/maps/place/Robbie's+of+Islamorada/" target="_blank" rel="noopener"
            class="border border-gray-300 text-gray-700 hover:border-gray-500 px-6 py-2.5 rounded font-semibold text-sm transition-colors">Get Directions</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
