---
// Google Reviews + Maps
// GMB Place ID for Robbie's of Islamorada: ChIJE-BfN1UAAH8RzGd6MN-QVGE (from their Google Maps URL)
const PLACE_ID = 'ChIJE-BfN1UAAH8RzGd6MN-QVGE';
const GOOGLE_MAPS_URL = `https://www.google.com/maps/place/?q=place_id:${PLACE_ID}`;
const REVIEW_URL = `https://search.google.com/local/writereview?placeid=${PLACE_ID}`;

// Trustindex widget ID — get from trustindex.io after connecting Google Business
// Free plan: go to trustindex.io → New Widget → Google → paste GMB → copy script
const TRUSTINDEX_ID = 'REPLACE_WITH_TRUSTINDEX_ID'; // e.g. "abc123def456"
const hasReviews = TRUSTINDEX_ID !== 'REPLACE_WITH_TRUSTINDEX_ID';
---

<section class="py-14 px-6 bg-gray-50 border-t border-gray-100">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-start">

      <!-- Left: Reviews -->
      <div>
        <p class="text-amber-600 text-xs font-semibold uppercase tracking-widest mb-2">What Guests Say</p>
        <h2 class="text-2xl font-bold text-gray-900 mb-2" style="font-family: 'Playfair Display', serif;">Google Reviews</h2>
        <div class="flex items-center gap-2 mb-6">
          <div class="flex text-amber-400 text-lg">★★★★★</div>
          <span class="text-gray-700 font-semibold">4.7</span>
          <span class="text-gray-400 text-sm">· Rated on Google</span>
        </div>

        {hasReviews ? (
          <!-- Trustindex widget loads here -->
          <div id="trustindex-reviews">
            <script
              src={`https://cdn.trustindex.io/loader.js?${TRUSTINDEX_ID}`}
              defer
              async
            ></script>
          </div>
        ) : (
          <!-- Static preview reviews until Trustindex is connected -->
          <div class="space-y-4">
            {[
              { name: 'Sarah M.', rating: 5, text: 'Absolutely incredible experience! Fed the tarpon and took the glass bottom boat tour — my kids are still talking about it. A must-do in the Florida Keys!', ago: '2 weeks ago' },
              { name: 'James T.', rating: 5, text: 'Best fishing trip I\'ve ever been on. Captain Michael and his crew were fantastic. Caught more fish than I expected and the whole experience was top-notch.', ago: '1 month ago' },
              { name: 'Lisa K.', rating: 5, text: 'The Hungry Tarpon Bloody Mary is LEGENDARY. Sat on the waterfront deck, watched the tarpon feeding, had the best brunch. Close to perfect, far from normal!', ago: '3 weeks ago' },
            ].map(r => (
              <div class="bg-white rounded-xl p-5 shadow-sm border border-gray-100">
                <div class="flex items-center gap-3 mb-3">
                  <div class="w-9 h-9 rounded-full bg-blue-100 flex items-center justify-center font-bold text-blue-700 text-sm flex-shrink-0">
                    {r.name[0]}
                  </div>
                  <div>
                    <p class="font-semibold text-gray-900 text-sm">{r.name}</p>
                    <div class="flex items-center gap-1">
                      <span class="text-amber-400 text-xs">{'★'.repeat(r.rating)}</span>
                      <span class="text-gray-400 text-xs">· {r.ago}</span>
                    </div>
                  </div>
                  <svg class="w-5 h-5 ml-auto flex-shrink-0" viewBox="0 0 24 24">
                    <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                    <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                    <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                    <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                  </svg>
                </div>
                <p class="text-gray-600 text-sm leading-relaxed">"{r.text}"</p>
              </div>
            ))}
          </div>
        )}

        <div class="flex gap-3 mt-6">
          <a
            href={REVIEW_URL}
            target="_blank"
            rel="noopener"
            class="flex items-center gap-2 bg-white border-2 border-blue-500 text-blue-600 hover:bg-blue-50 px-5 py-2.5 rounded-lg text-sm font-semibold transition-colors"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
            </svg>
            Write a Review
          </a>
          <a
            href={GOOGLE_MAPS_URL}
            target="_blank"
            rel="noopener"
            class="flex items-center gap-2 bg-white border border-gray-200 text-gray-700 hover:border-gray-400 px-5 py-2.5 rounded-lg text-sm font-semibold transition-colors"
          >
            View All Reviews
          </a>
        </div>
      </div>

      <!-- Right: Google Map -->
      <div>
        <p class="text-amber-600 text-xs font-semibold uppercase tracking-widest mb-2">Find Us</p>
        <h2 class="text-2xl font-bold text-gray-900 mb-4" style="font-family: 'Playfair Display', serif;">77522 Overseas Hwy, Islamorada</h2>
        <div class="rounded-2xl overflow-hidden shadow-md border border-gray-200" style="height: 340px;">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3583.06!2d-80.6344!3d24.9225!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x88f800053f5fe013%3A0x615590dfe6a33f86!2sRobbie&#39;s%20of%20Islamorada!5e0!3m2!1sen!2sus!4v1"
            width="100%"
            height="340"
            style="border:0;"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Robbie's of Islamorada on Google Maps"
          ></iframe>
        </div>
        <a
          href={GOOGLE_MAPS_URL}
          target="_blank"
          rel="noopener"
          class="flex items-center justify-center gap-2 mt-3 text-blue-600 hover:text-blue-800 text-sm font-semibold transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          Get Directions on Google Maps
        </a>
      </div>

    </div>
  </div>
</section>
