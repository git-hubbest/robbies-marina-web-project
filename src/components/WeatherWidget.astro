<!-- 7-Day Islamorada Weather — pulls live from Open-Meteo, no API key needed -->
<section class="py-10 px-6" style="background-color: #0d2a4a;">
  <div class="max-w-5xl mx-auto">
    <div class="flex items-center justify-between mb-6">
      <div>
        <p class="text-amber-400 text-xs font-semibold uppercase tracking-widest mb-1">Islamorada, FL</p>
        <h2 class="text-white font-bold text-lg" style="font-family: 'Playfair Display', serif;">7-Day Forecast</h2>
      </div>
      <span id="weather-updated" class="text-white/30 text-xs"></span>
    </div>

    <!-- Loading state -->
    <div id="weather-loading" class="grid grid-cols-4 sm:grid-cols-7 gap-2">
      {Array.from({length: 7}).map((_, i) => (
        <div class={`bg-white/5 rounded-xl h-28 animate-pulse ${i >= 4 ? 'hidden sm:block' : ''}`}></div>
      ))}
    </div>

    <!-- Weather grid — 4 col mobile, 7 col sm+ -->
    <div id="weather-grid" class="hidden grid-cols-4 sm:grid-cols-7 gap-2"></div>

    <!-- Error state -->
    <div id="weather-error" class="hidden text-white/40 text-sm text-center py-4">
      Unable to load forecast
    </div>
  </div>
</section>

<script>
const WMO_CODES: Record<number, { label: string; emoji: string }> = {
  0:  { label: 'Clear', emoji: '☀️' },
  1:  { label: 'Mainly Clear', emoji: '🌤️' },
  2:  { label: 'Partly Cloudy', emoji: '⛅' },
  3:  { label: 'Overcast', emoji: '☁️' },
  45: { label: 'Foggy', emoji: '🌫️' },
  48: { label: 'Foggy', emoji: '🌫️' },
  51: { label: 'Light Drizzle', emoji: '🌦️' },
  53: { label: 'Drizzle', emoji: '🌦️' },
  55: { label: 'Heavy Drizzle', emoji: '🌧️' },
  61: { label: 'Light Rain', emoji: '🌧️' },
  63: { label: 'Rain', emoji: '🌧️' },
  65: { label: 'Heavy Rain', emoji: '⛈️' },
  71: { label: 'Light Snow', emoji: '🌨️' },
  73: { label: 'Snow', emoji: '❄️' },
  75: { label: 'Heavy Snow', emoji: '❄️' },
  80: { label: 'Showers', emoji: '🌦️' },
  81: { label: 'Showers', emoji: '🌧️' },
  82: { label: 'Heavy Showers', emoji: '⛈️' },
  95: { label: 'Thunderstorm', emoji: '⛈️' },
  96: { label: 'Thunderstorm', emoji: '⛈️' },
  99: { label: 'Thunderstorm', emoji: '⛈️' },
};

const DAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

async function loadWeather() {
  const grid = document.getElementById('weather-grid')!;
  const loading = document.getElementById('weather-loading')!;
  const error = document.getElementById('weather-error')!;
  const updated = document.getElementById('weather-updated')!;

  try {
    const url = 'https://api.open-meteo.com/v1/forecast?latitude=24.9225&longitude=-80.6318&daily=temperature_2m_max,temperature_2m_min,precipitation_probability_max,weathercode,windspeed_10m_max&temperature_unit=fahrenheit&windspeed_unit=mph&timezone=America%2FNew_York&forecast_days=7';
    const res = await fetch(url);
    const data = await res.json();
    const { daily } = data;

    grid.innerHTML = '';

    for (let i = 0; i < 7; i++) {
      const date = new Date(daily.time[i] + 'T12:00:00');
      const dayName = i === 0 ? 'Today' : DAYS[date.getDay()];
      const code = daily.weathercode[i] as number;
      const weather = WMO_CODES[code] ?? WMO_CODES[3];
      const hi = Math.round(daily.temperature_2m_max[i]);
      const lo = Math.round(daily.temperature_2m_min[i]);
      const rain = daily.precipitation_probability_max[i];
      const wind = Math.round(daily.windspeed_10m_max[i]);

      const card = document.createElement('div');
      card.className = 'flex flex-col items-center text-center px-1 py-4 rounded-xl ' + (i === 0 ? 'bg-white/15' : 'bg-white/5 hover:bg-white/10 transition-colors');
      card.innerHTML = `
        <p class="text-white/60 text-xs font-semibold uppercase tracking-wide mb-2">${dayName}</p>
        <span class="text-3xl mb-2 leading-none">${weather.emoji}</span>
        <p class="text-white text-xs font-medium mb-2 leading-tight">${weather.label}</p>
        <p class="text-white font-bold text-sm">${hi}°</p>
        <p class="text-white/40 text-xs">${lo}°</p>
        ${rain > 10 ? `<p class="text-blue-300 text-xs mt-1.5">💧 ${rain}%</p>` : ''}
        <p class="text-white/30 text-xs mt-1">${wind}mph</p>
      `;
      grid.appendChild(card);
    }

    loading.classList.add('hidden');
    grid.classList.remove('hidden');
    grid.classList.add('grid');
    // On mobile show only 4 days, rest hidden until sm breakpoint
    grid.querySelectorAll(':scope > div').forEach((card, i) => {
      if (i >= 4) (card as HTMLElement).classList.add('hidden', 'sm:block');
    });
    updated.textContent = 'Updated ' + new Date().toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });

  } catch (e) {
    loading.classList.add('hidden');
    error.classList.remove('hidden');
  }
}

loadWeather();
</script>
