---

<header id="site-header" class="sticky top-0 left-0 right-0 z-50 bg-white shadow-sm">
  <div class="max-w-screen-xl mx-auto px-6 py-3 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex-shrink-0">
      <img src="/robbies-logo.png" alt="Robbie's of Islamorada" class="h-12 w-auto" />
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden lg:flex items-center gap-0">
      {navItems.map((item, idx) => (
        <div class="nav-item relative group" data-idx={idx}>
          <a
            href={item.href}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener' : undefined}
            class="nav-trigger block px-3 py-4 text-xs font-semibold tracking-wide text-gray-700 hover:text-blue-700 transition-colors whitespace-nowrap uppercase"
            style="font-family: 'Inter', sans-serif; letter-spacing: 0.05em;"
          >
            {item.label}
          </a>
          {idx < navItems.length - 1 && !item.external && <span class="absolute right-0 top-1/2 -translate-y-1/2 text-gray-300 text-xs pointer-events-none">|</span>}

          {/* Mega menu panel */}
          {(item.cols || item.sections) && (
            <div
              class="mega-panel absolute top-full left-1/2 -translate-x-1/2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50 pointer-events-none group-hover:pointer-events-auto"
              style="min-width: 780px;"
            >
              <div class="flex shadow-2xl mt-0" style="background-color: #1a3a6e;">

                {/* Left: links */}
                <div class="flex-1 p-8">
                  {item.heading && (
                    <p class="text-white font-bold text-sm mb-5 uppercase tracking-widest">{item.heading}</p>
                  )}

                  {/* Simple 2-col */}
                  {item.cols && (
                    <div class="grid grid-cols-2 gap-x-8 gap-y-1">
                      {item.cols.map(col => (
                        <div>
                          {col.map(link => (
                            <a href={link.href} class="block text-white/80 hover:text-white text-xs py-1.5 uppercase tracking-wide transition-colors" style="font-size: 11px; letter-spacing: 0.08em;">
                              {link.label}
                            </a>
                          ))}
                        </div>
                      ))}
                    </div>
                  )}

                  {/* Sectioned (fishing, contact) */}
                  {item.sections && item.sections.map((section, si) => (
                    <div class={si > 0 ? 'mt-6 pt-6 border-t border-white/20' : ''}>
                      <p class="text-white font-bold text-xs mb-4 uppercase tracking-widest">{section.heading}</p>
                      <div class="grid grid-cols-2 gap-x-8 gap-y-1">
                        {section.cols.map(col => (
                          <div>
                            {col.map(link => (
                              <a href={link.href} class="block text-white/80 hover:text-white text-xs py-1.5 uppercase tracking-wide transition-colors" style="font-size: 11px; letter-spacing: 0.08em;">
                                {link.label}
                              </a>
                            ))}
                          </div>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>

                {/* Right: photo */}
                {item.image && (
                  <div class="w-72 flex-shrink-0 overflow-hidden">
                    <img
                      src={item.image}
                      alt={item.imageAlt || ''}
                      class="w-full h-full object-cover"
                      loading="lazy"
                    />
                  </div>
                )}

              </div>
            </div>
          )}
        </div>
      ))}
    </nav>

    <!-- Right: cart, search, phone -->
    <div class="hidden lg:flex items-center gap-4 flex-shrink-0">
      <a href="https://shop.robbies.com/" target="_blank" rel="noopener" class="text-gray-600 hover:text-blue-700 transition-colors" aria-label="Shop">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
        </svg>
      </a>
      <button class="text-gray-600 hover:text-blue-700 transition-colors" aria-label="Search">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
      </button>
      <a href="tel:3056648070" class="flex items-center gap-1.5 text-gray-700 hover:text-blue-700 transition-colors text-sm font-semibold whitespace-nowrap">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/>
        </svg>
        (305) 664-8070
      </a>
    </div>

    <!-- Mobile hamburger -->
    <button id="menu-toggle" class="lg:hidden text-gray-700 p-2" aria-label="Toggle menu">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-gray-200 bg-white max-h-screen overflow-y-auto">
    <div class="px-6 py-4 flex flex-col gap-1">
      {navItems.map(item => (
        <a
          href={item.href}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener' : undefined}
          class="text-gray-700 hover:text-blue-700 text-sm font-semibold uppercase tracking-wide py-2.5 border-b border-gray-100 transition-colors"
        >
          {item.label}
        </a>
      ))}
      <a href="tel:3056648070" class="text-blue-700 font-semibold text-sm py-3 text-center">
        📞 (305) 664-8070
      </a>
      <a href="https://fareharbor.com/hungrytarpon/" target="_blank" rel="noopener"
        class="bg-amber-500 text-white px-5 py-3 rounded text-sm font-semibold text-center mt-1">
        Book Now
      </a>
    </div>
  </div>
</header>

<style>
  .mega-panel {
    transform: translateX(-50%);
  }
</style>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  menuToggle?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => mobileMenu?.classList.add('hidden'));
  });
</script>
