---

<!-- Header wrapper — position relative so mega menu anchors to it -->
<div class="sticky top-0 z-50 bg-white shadow-sm" id="site-header-wrapper">
  <!-- Nav bar -->
  <div class="max-w-screen-2xl mx-auto px-4 flex items-center justify-between" style="height: 64px;">
    <!-- Logo -->
    <a href="/" class="flex-shrink-0 mr-4">
      <img src="/robbies-logo.png" alt="Robbie's of Islamorada" class="h-11 w-auto" />
    </a>

    <!-- Desktop nav items -->
    <nav class="hidden lg:flex items-center flex-1 justify-center" id="main-nav">
      {navItems.map((item, idx) => (
        <div class="relative flex items-center">
          <a
            href={item.href}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener' : undefined}
            data-menu-id={item.sections ? item.id : undefined}
            class="nav-link block px-3 py-5 text-xs font-bold text-gray-700 hover:text-blue-700 transition-colors whitespace-nowrap uppercase tracking-wide"
          >
            {item.label}
          </a>
          {idx < navItems.length - 1 && (
            <span class="text-gray-300 text-xs select-none">|</span>
          )}
        </div>
      ))}
    </nav>

    <!-- Right icons -->
    <div class="hidden lg:flex items-center gap-4 flex-shrink-0">
      <a href="https://shop.robbies.com/" target="_blank" rel="noopener" class="text-gray-500 hover:text-blue-700 transition-colors" aria-label="Shop">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
      </a>
      <button class="text-gray-500 hover:text-blue-700 transition-colors" aria-label="Search">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      </button>
      <a href="tel:3056648070" class="flex items-center gap-1.5 text-gray-700 hover:text-blue-700 transition-colors text-sm font-semibold whitespace-nowrap">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/></svg>
        (305) 664-8070
      </a>
    </div>

    <!-- Mobile hamburger -->
    <button id="menu-toggle" class="lg:hidden text-gray-700 p-2 ml-auto" aria-label="Toggle menu">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
  </div>

  <!-- MEGA MENU PANEL — anchored to bottom of header, full width -->
  <div
    id="mega-panel"
    class="absolute left-0 right-0 top-full hidden shadow-2xl z-40"
    style="background-color: #1a3a6e;"
  >
    {navItems.filter(i => i.sections).map(item => (
      <div class="mega-content hidden" data-content-id={item.id}>
        <div class="max-w-screen-xl mx-auto flex" style="min-height: 280px;">
          <!-- Left: links -->
          <div class="flex-1 p-8">
            {item.sections!.map((section, si) => (
              <div class={si > 0 ? 'mt-6 pt-6 border-t border-white/20' : ''}>
                <p class="text-white font-bold text-xs mb-4 uppercase tracking-widest opacity-60">{section.heading}</p>
                <div class="grid grid-cols-2 gap-x-12">
                  {section.cols.map(col => (
                    <div class="space-y-0.5">
                      {col.map(link => (
                        <a
                          href={link.href}
                          class="block text-white/85 hover:text-white text-xs py-1.5 uppercase tracking-wider transition-colors hover:translate-x-1 duration-150"
                          style="font-size: 11px; letter-spacing: 0.07em;"
                          target={link.href.startsWith('http') ? '_blank' : undefined}
                          rel={link.href.startsWith('http') ? 'noopener' : undefined}
                        >
                          {link.label}
                        </a>
                      ))}
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>

          <!-- Right: photo -->
          <div class="w-80 flex-shrink-0">
            <img
              src={item.image}
              alt={item.imageAlt || ''}
              class="w-full h-full object-cover"
              loading="lazy"
              style="min-height: 280px;"
            />
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden lg:hidden bg-white border-t border-gray-200 max-h-screen overflow-y-auto">
    <div class="px-6 py-4 flex flex-col gap-1">
      {navItems.map(item => (
        <a
          href={item.href}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener' : undefined}
          class="text-gray-700 hover:text-blue-700 text-sm font-bold uppercase tracking-wide py-3 border-b border-gray-100 transition-colors"
        >
          {item.label}
        </a>
      ))}
      <a href="tel:3056648070" class="text-blue-700 font-semibold text-sm py-3 text-center mt-1">
        📞 (305) 664-8070
      </a>
      <a href="https://fareharbor.com/hungrytarpon/" target="_blank" rel="noopener"
        class="bg-amber-500 text-white py-3 rounded text-sm font-semibold text-center mt-1">
        Book Now
      </a>
    </div>
  </div>
</div>

<script>
  const panel = document.getElementById('mega-panel');
  const wrapper = document.getElementById('site-header-wrapper');
  const navLinks = document.querySelectorAll('[data-menu-id]');
  let activeId: string | null = null;
  let hideTimer: ReturnType<typeof setTimeout>;

  function showMenu(id: string) {
    clearTimeout(hideTimer);
    if (activeId === id && !panel!.classList.contains('hidden')) return;

    // Hide all content panels
    document.querySelectorAll('.mega-content').forEach(el => el.classList.add('hidden'));

    // Show the right one
    const content = document.querySelector(`[data-content-id="${id}"]`);
    if (content) {
      content.classList.remove('hidden');
      panel!.classList.remove('hidden');
      activeId = id;

      // Highlight active nav link
      navLinks.forEach(l => l.classList.remove('text-blue-700'));
      document.querySelector(`[data-menu-id="${id}"]`)?.classList.add('text-blue-700');
    }
  }

  function hideMenu() {
    hideTimer = setTimeout(() => {
      panel!.classList.add('hidden');
      navLinks.forEach(l => l.classList.remove('text-blue-700'));
      activeId = null;
    }, 150);
  }

  // Nav link hover
  navLinks.forEach(link => {
    link.addEventListener('mouseenter', () => {
      const id = link.getAttribute('data-menu-id');
      if (id) showMenu(id);
    });
    link.addEventListener('mouseleave', hideMenu);
  });

  // Keep panel open when hovering it
  panel?.addEventListener('mouseenter', () => clearTimeout(hideTimer));
  panel?.addEventListener('mouseleave', hideMenu);

  // Close on nav links without menus
  document.querySelectorAll('.nav-link:not([data-menu-id])').forEach(link => {
    link.addEventListener('mouseenter', () => {
      clearTimeout(hideTimer);
      panel!.classList.add('hidden');
      navLinks.forEach(l => l.classList.remove('text-blue-700'));
      activeId = null;
    });
  });

  // Mobile toggle
  document.getElementById('menu-toggle')?.addEventListener('click', () => {
    document.getElementById('mobile-menu')?.classList.toggle('hidden');
  });

  document.querySelectorAll('#mobile-menu a').forEach(link => {
    link.addEventListener('click', () => {
      document.getElementById('mobile-menu')?.classList.add('hidden');
    });
  });
</script>
