---
const menus = [
  {
    label: 'Activities',
    href: '/activities',
    cols: [
      {
        heading: 'Water Adventures',
        links: [
          { label: '🐟 Tarpon Feeding', href: '/activities' },
          { label: '🤿 Snorkeling Tours', href: '/snorkeling' },
          { label: '🪸 Glass Bottom Boat', href: '/glass-bottom-boat' },
          { label: '🌊 SNUBA Diving', href: '/activities' },
          { label: '🚣 Kayak & Paddleboard', href: '/kayak-paddleboard' },
          { label: '💨 Jet Ski Adventures', href: '/kayak-paddleboard' },
        ]
      },
      {
        heading: 'On the Water',
        links: [
          { label: '🌅 Sunset Cruises', href: '/sunset-cruises' },
          { label: '🛥️ Four Aces Yacht', href: '/four-aces' },
          { label: '⛵ Boat Rentals', href: '/boat-rentals' },
          { label: '🌿 Eco Tours', href: '/eco-tours' },
        ]
      },
      {
        heading: 'Explore & Dine',
        links: [
          { label: '🍽️ Hungry Tarpon Restaurant', href: '/dining' },
          { label: '🛍️ Tropical Open Air Market', href: '/market' },
          { label: '📜 History Tours', href: '/history-tours' },
          { label: '💍 Weddings & Events', href: '/weddings-events' },
          { label: '📖 Our History', href: '/history' },
        ]
      }
    ]
  },
  {
    label: 'Fishing',
    href: '/fishing',
    cols: [
      {
        heading: 'Party Boat',
        links: [
          { label: '🎣 Captain Michael Party Boat', href: '/fishing' },
          { label: '🌙 Night Fishing', href: '/fishing' },
          { label: '🤝 Split (Shared) Charters', href: '/fishing' },
        ]
      },
      {
        heading: 'Private Charters',
        links: [
          { label: '🦈 Tarpon & Shark Fishing', href: '/fishing' },
          { label: '🌊 Offshore Fishing', href: '/fishing' },
          { label: '⚔️ Swordfish Fishing', href: '/fishing' },
          { label: '🐟 Mahi-Mahi Fishing', href: '/fishing' },
          { label: '🪸 Reef & Wreck Fishing', href: '/fishing' },
          { label: '🌿 Backcountry Fishing', href: '/fishing' },
        ]
      },
      {
        heading: 'Resources',
        links: [
          { label: '📅 Fishing Calendar', href: '/fishing' },
          { label: '👨‍👩‍👧 Family Fishing', href: '/fishing' },
          { label: '📝 Blog: Winter Fishing', href: '/blog/winter-fishing-islamorada' },
          { label: '📝 Best Fish in Winter', href: '/blog/best-fish-winter' },
        ]
      }
    ]
  },
  {
    label: 'Snorkeling',
    href: '/snorkeling',
    simple: true,
    links: [
      { label: 'Sundance Watersports (Daily 10am & 1:30pm)', href: '/snorkeling' },
      { label: 'KeyZ Charters (Private, 6 or fewer)', href: '/snorkeling' },
      { label: 'Glass Bottom Boat Tours', href: '/glass-bottom-boat' },
      { label: 'SNUBA Diving', href: '/activities' },
      { label: 'Blog: Top Snorkel Spots', href: '/blog/top-places-to-snorkel-islamorada' },
      { label: 'Blog: Snorkeling vs SNUBA', href: '/blog/snorkeling-vs-snuba' },
    ]
  },
  {
    label: 'Dining',
    href: '/dining',
    simple: true,
    links: [
      { label: 'Hungry Tarpon Restaurant', href: '/dining' },
      { label: 'Thirsty Tarpon Bar', href: '/dining' },
      { label: 'Cook Your Catch', href: '/dining' },
      { label: 'Top 10 Places to Eat', href: '/blog/top-places-to-eat-islamorada' },
    ]
  },
  {
    label: 'Sunset Cruises',
    href: '/sunset-cruises',
    simple: true,
    links: [
      { label: 'Sundance Watersports (from $49)', href: '/sunset-cruises' },
      { label: "KeyZ Charters (Private)", href: '/sunset-cruises' },
      { label: 'Four Aces Luxury Yacht (from $1,000)', href: '/sunset-cruises' },
      { label: 'Weddings & Private Events', href: '/weddings-events' },
    ]
  },
  { label: 'Blog', href: '/blog' },
];
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-6 py-3 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 flex-shrink-0 z-10">
      <img src="/robbies-logo.png" alt="Robbie's of Islamorada" class="h-10 w-auto" />
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden xl:flex items-center gap-1">
      {menus.map(menu => (
        <div class="relative group">
          <a
            href={menu.href}
            class="text-white/90 hover:text-white text-sm font-medium px-3 py-2 rounded hover:bg-white/10 transition-colors whitespace-nowrap flex items-center gap-1"
          >
            {menu.label}
            {(menu.cols || menu.simple) && (
              <svg class="w-3 h-3 opacity-60 group-hover:opacity-100 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            )}
          </a>

          {/* Multi-column mega menu */}
          {menu.cols && (
            <div class="mega-menu absolute top-full left-1/2 -translate-x-1/2 mt-1 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 pointer-events-none group-hover:pointer-events-auto z-50"
              style="min-width: 640px;">
              <div class="bg-white rounded-xl shadow-2xl border border-gray-100 p-6 mt-2">
                <div class={`grid grid-cols-${menu.cols.length} gap-8`}>
                  {menu.cols.map(col => (
                    <div>
                      <p class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-3">{col.heading}</p>
                      <ul class="space-y-1">
                        {col.links.map(link => (
                          <li>
                            <a href={link.href} class="text-gray-700 hover:text-amber-600 text-sm block py-1 transition-colors">
                              {link.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
                <div class="border-t border-gray-100 mt-5 pt-4 flex justify-between items-center">
                  <p class="text-xs text-gray-400">📍 77522 Overseas Hwy, Islamorada FL · Mon–Sun 7am–9pm</p>
                  <a href="https://fareharbor.com/hungrytarpon/" target="_blank" rel="noopener"
                    class="bg-amber-500 hover:bg-amber-400 text-white px-4 py-1.5 rounded text-xs font-semibold transition-colors">
                    Book Now
                  </a>
                </div>
              </div>
            </div>
          )}

          {/* Simple dropdown */}
          {menu.simple && menu.links && (
            <div class="absolute top-full left-0 mt-1 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 pointer-events-none group-hover:pointer-events-auto z-50"
              style="min-width: 280px;">
              <div class="bg-white rounded-xl shadow-2xl border border-gray-100 p-4 mt-2">
                <ul class="space-y-1">
                  {menu.links.map(link => (
                    <li>
                      <a href={link.href} class="text-gray-700 hover:text-amber-600 text-sm block py-1.5 px-2 rounded hover:bg-amber-50 transition-colors">
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          )}
        </div>
      ))}

      <a href="tel:3056648070" class="text-white/70 hover:text-white text-sm px-2 transition-colors whitespace-nowrap">
        (305) 664-8070
      </a>

      <a href="https://fareharbor.com/hungrytarpon/" target="_blank" rel="noopener"
        class="ml-2 bg-amber-500 hover:bg-amber-400 text-white px-5 py-2 rounded text-sm font-semibold tracking-wide transition-colors whitespace-nowrap">
        Book Now
      </a>
    </nav>

    <!-- Mobile: phone + hamburger -->
    <div class="xl:hidden flex items-center gap-4">
      <a href="tel:3056648070" class="text-white/80 hover:text-white text-sm font-medium">
        📞 305-664-8070
      </a>
      <button id="menu-toggle" class="text-white p-2" aria-label="Toggle menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden xl:hidden border-t border-white/10" style="background-color: #0a1628; max-height: 80vh; overflow-y: auto;">
    <div class="px-6 py-4 flex flex-col gap-2">
      {menus.map(menu => (
        <a href={menu.href} class="text-white/90 hover:text-white text-sm font-medium py-2 border-b border-white/10 transition-colors">
          {menu.label}
        </a>
      ))}
      <a href="/history" class="text-white/90 hover:text-white text-sm font-medium py-2 border-b border-white/10 transition-colors">Our History</a>
      <a href="/weddings-events" class="text-white/90 hover:text-white text-sm font-medium py-2 border-b border-white/10 transition-colors">Weddings & Events</a>
      <a href="/market" class="text-white/90 hover:text-white text-sm font-medium py-2 border-b border-white/10 transition-colors">Open Air Market</a>
      <a href="https://fareharbor.com/hungrytarpon/" target="_blank" rel="noopener"
        class="bg-amber-500 text-white px-5 py-3 rounded text-sm font-semibold text-center mt-2">
        Book Now
      </a>
      <div class="text-white/50 text-xs text-center pt-2">
        📍 77522 Overseas Hwy, Islamorada FL 33036
      </div>
    </div>
  </div>
</header>

<style>
  #site-header.scrolled {
    background-color: #0a1628;
    box-shadow: 0 2px 20px rgba(0,0,0,0.3);
  }
  .mega-menu { transform: translateX(-50%) translateY(-4px); }
  .group:hover .mega-menu { transform: translateX(-50%) translateY(0); }
</style>

<script>
  const header = document.getElementById('site-header');
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      header?.classList.add('scrolled');
    } else {
      header?.classList.remove('scrolled');
    }
  });

  menuToggle?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => mobileMenu.classList.add('hidden'));
  });
</script>
