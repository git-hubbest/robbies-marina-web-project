---
interface Props {
  headline?: string;
  subtext?: string;
}
const {
  headline = "Ready to Experience the Florida Keys?",
  subtext = "Book your adventure at Robbie's Marina today."
} = Astro.props;
---

<section class="py-20 px-6 text-center" style="background-color: #c9a84c;">
  <h2 class="text-3xl md:text-4xl font-bold text-white mb-4" style="font-family: 'Playfair Display', serif;">
    {headline}
  </h2>
  <p class="text-white/80 text-lg mb-8">{subtext}</p>
  <a
    href="https://fareharbor.com/hungrytarpon/"
    target="_blank"
    rel="noopener"
    class="inline-block bg-white text-amber-700 px-10 py-4 rounded font-bold text-lg hover:bg-gray-100 transition-colors shadow-lg"
  >
    Book Now
  </a>
</section>
