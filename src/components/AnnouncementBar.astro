---
const messages = [
  { text: "Click To Book A Fishing Trip", href: "/fishing" },
  { text: "Trivia Night Every Tues. 6:30pm – 8:30pm at Hungry Tarpon Restaurant", href: "/dining" },
  { text: "Click To Shop Robbie's Merch", href: "https://shop.robbies.com/" },
  { text: "Glass Bottom Boat Tours — 4 Daily Departures Including Night Tour", href: "/glass-bottom-boat" },
  { text: "Brad Bertelli History Tours — Mon & Thu · 11:30am & 2:30pm", href: "/history-tours" },
];
---

<div id="announcement-bar" class="relative flex items-center justify-center text-white text-sm font-medium py-2 px-12 overflow-hidden" style="background-color: #2d5fa8; min-height: 38px;">
  <!-- Arrows -->
  <button id="ann-prev" class="absolute left-4 text-white/70 hover:text-white text-lg font-bold transition-colors select-none" aria-label="Previous">&#8249;</button>
  <button id="ann-next" class="absolute right-4 text-white/70 hover:text-white text-lg font-bold transition-colors select-none" aria-label="Next">&#8250;</button>

  <!-- Messages -->
  <div class="relative w-full text-center" style="min-height: 20px;">
    {messages.map((msg, i) => (
      <a
        href={msg.href}
        class={`announcement-msg block w-full text-center transition-opacity duration-500 hover:underline ${i === 0 ? '' : 'absolute inset-0 opacity-0'}`}
        data-index={i}
        target={msg.href.startsWith('http') ? '_blank' : undefined}
        rel={msg.href.startsWith('http') ? 'noopener' : undefined}
      >
        {msg.text}
      </a>
    ))}
  </div>
</div>

<script>
  const msgs = Array.from(document.querySelectorAll('.announcement-msg')) as HTMLElement[];
  let current = 0;
  let timer: ReturnType<typeof setInterval>;

  function goTo(index: number) {
    msgs[current].classList.add('opacity-0');
    msgs[current].classList.remove('relative');
    msgs[current].classList.add('absolute', 'inset-0');
    current = (index + msgs.length) % msgs.length;
    msgs[current].classList.remove('opacity-0', 'absolute', 'inset-0');
    msgs[current].classList.add('relative');
  }

  function startTimer() {
    clearInterval(timer);
    timer = setInterval(() => goTo(current + 1), 5000);
  }

  document.getElementById('ann-prev')?.addEventListener('click', () => { goTo(current - 1); startTimer(); });
  document.getElementById('ann-next')?.addEventListener('click', () => { goTo(current + 1); startTimer(); });

  startTimer();
</script>
