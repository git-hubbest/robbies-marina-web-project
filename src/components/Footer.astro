---
const activities = [
  { label: 'Tarpon Feeding', href: '/activities' },
  { label: 'Glass Bottom Boat', href: '/glass-bottom-boat' },
  { label: 'Snorkeling Tours', href: '/snorkeling' },
  { label: 'Fishing Charters', href: '/fishing' },
  { label: 'Kayak & Paddleboard', href: '/kayak-paddleboard' },
  { label: 'Sunset Cruises', href: '/sunset-cruises' },
  { label: 'Eco Tours', href: '/eco-tours' },
  { label: 'Boat Rentals', href: '/boat-rentals' },
  { label: 'Four Aces Yacht', href: '/four-aces' },
  { label: 'History Tours', href: '/history-tours' },
  { label: 'Dining', href: '/dining' },
];
---

<footer style="background-color: #0a1628;" class="text-white">
  <div class="max-w-7xl mx-auto px-6 py-16">
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-12">

      <!-- Brand -->
      <div class="lg:col-span-1">
        <a href="/">
          <img src="/robbies-logo.png" alt="Robbie's of Islamorada" class="h-14 w-auto mb-4" />
        </a>
        <p class="text-white/60 text-sm leading-relaxed mb-4">
          Home of the world-famous tarpon feeding! Voted #1 Place in the Florida Keys every tourist should visit.
        </p>
        <p class="text-white/60 text-sm italic">"Close to perfect, far from normal."</p>

        <!-- Social Icons -->
        <div class="flex gap-3 mt-5">
          <a href="https://www.instagram.com/robbiesofislamorada/" target="_blank" rel="noopener" aria-label="Instagram"
            class="w-8 h-8 bg-white/10 hover:bg-amber-500 rounded-full flex items-center justify-center transition-colors text-xs">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
          <a href="https://www.facebook.com/robbiesofislamorada/" target="_blank" rel="noopener" aria-label="Facebook"
            class="w-8 h-8 bg-white/10 hover:bg-amber-500 rounded-full flex items-center justify-center transition-colors">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="https://www.tiktok.com/@robbiesofislamorada" target="_blank" rel="noopener" aria-label="TikTok"
            class="w-8 h-8 bg-white/10 hover:bg-amber-500 rounded-full flex items-center justify-center transition-colors text-xs font-bold">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.19 8.19 0 004.79 1.52V6.76a4.85 4.85 0 01-1.02-.07z"/></svg>
          </a>
          <a href="https://www.youtube.com/channel/UC87uKTXV7je0G6h3eUqMaNQ" target="_blank" rel="noopener" aria-label="YouTube"
            class="w-8 h-8 bg-white/10 hover:bg-amber-500 rounded-full flex items-center justify-center transition-colors">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
        </div>
      </div>

      <!-- Activities -->
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-widest text-white/40 mb-4">Activities</h4>
        <ul class="space-y-2">
          {activities.map(link => (
            <li>
              <a href={link.href} class="text-white/70 hover:text-amber-400 text-sm transition-colors">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Hours -->
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-widest text-white/40 mb-4">Hours of Operation</h4>
        <div class="space-y-3 text-sm">
          {[
            { name: "Robbie's of Islamorada", hours: "7:00am – 9:00pm" },
            { name: "Tarpon Booth", hours: "7:00am – 9:00pm" },
            { name: "Hungry Tarpon Restaurant", hours: "6:30am – 9:00pm" },
            { name: "Captain Michael Fishing", hours: "7:00am – 8:00pm" },
          ].map(item => (
            <div>
              <p class="text-white font-medium text-xs">{item.name}</p>
              <p class="text-white/50 text-xs">Mon–Sun: {item.hours}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-widest text-white/40 mb-4">Contact</h4>
        <div class="space-y-3 text-sm">
          <div>
            <a href="https://www.google.com/maps?q=77522+Overseas+Hwy+Islamorada+FL+33036" target="_blank" rel="noopener"
              class="text-white/70 hover:text-white transition-colors text-xs leading-relaxed block">
              📍 77522 Overseas Hwy<br />Islamorada, FL 33036
            </a>
          </div>
          <div>
            <a href="tel:3056648070" class="text-white/70 hover:text-amber-400 transition-colors text-xs block">
              📞 (305) 664-8070
            </a>
          </div>
          <div>
            <a href="mailto:booth@robbies.com" class="text-white/70 hover:text-amber-400 transition-colors text-xs block">
              ✉️ booth@robbies.com
            </a>
          </div>
          <div class="pt-2">
            <a href="https://fareharbor.com/hungrytarpon/" target="_blank" rel="noopener"
              class="inline-block bg-amber-500 hover:bg-amber-400 text-white px-5 py-2 rounded text-xs font-semibold transition-colors">
              Book Now
            </a>
          </div>
          <div class="pt-2 space-y-1">
            <p class="text-white/40 text-xs font-semibold uppercase tracking-widest">Also Visit</p>
            <a href="https://hungrytarpon.com" target="_blank" rel="noopener" class="text-white/50 hover:text-white text-xs block transition-colors">hungrytarpon.com</a>
            <a href="https://captainmichaelfishing.com" target="_blank" rel="noopener" class="text-white/50 hover:text-white text-xs block transition-colors">captainmichaelfishing.com</a>
            <a href="https://glassbottomtour.com" target="_blank" rel="noopener" class="text-white/50 hover:text-white text-xs block transition-colors">glassbottomtour.com</a>
          </div>
        </div>
      </div>

    </div>

    <div class="border-t border-white/10 mt-12 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-white/30">
      <p>© {new Date().getFullYear()} Robbie's of Islamorada. All rights reserved.</p>
      <div class="flex gap-4">
        <a href="https://www.robbies.com/privacy-policy.htm" target="_blank" rel="noopener" class="hover:text-white/60 transition-colors">Privacy Policy</a>
        <a href="https://www.robbies.com/terms-of-service.htm" target="_blank" rel="noopener" class="hover:text-white/60 transition-colors">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
