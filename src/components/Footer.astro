---
const links = [
  { label: 'Tarpon Feeding', href: '/activities' },
  { label: 'Fishing', href: '/fishing' },
  { label: 'Snorkeling', href: '/snorkeling' },
  { label: 'Sunset Cruises', href: '/sunset-cruises' },
  { label: 'Dining', href: '/dining' },
  { label: 'Glass Bottom Boat', href: '/glass-bottom-boat' },
  { label: 'Kayak & Paddleboard', href: '/kayak-paddleboard' },
  { label: 'Eco Tours', href: '/eco-tours' },
  { label: 'Boat Rentals', href: '/boat-rentals' },
  { label: 'Four Aces Yacht', href: '/four-aces' },
  { label: 'History Tours', href: '/history-tours' },
];
---

<footer style="background-color: #0a1628;" class="text-white">
  <div class="max-w-7xl mx-auto px-6 py-16">
    <div class="grid md:grid-cols-3 gap-12">
      <!-- Brand -->
      <div>
        <h3 class="text-2xl font-bold mb-4" style="font-family: 'Playfair Display', serif;">Robbie's Marina</h3>
        <p class="text-white/60 text-sm leading-relaxed mb-4">
          Voted #1 Place in the Florida Keys Every Tourist Should Visit. Home of the world-famous tarpon feeding.
        </p>
        <p class="text-white/60 text-sm">
          77522 Overseas Hwy<br />
          Islamorada, FL 33036
        </p>
      </div>

      <!-- Links -->
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-widest text-white/40 mb-4">Explore</h4>
        <ul class="space-y-2">
          {links.map(link => (
            <li>
              <a href={link.href} class="text-white/70 hover:text-white text-sm transition-colors">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Hours -->
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-widest text-white/40 mb-4">Hours</h4>
        <div class="space-y-3 text-sm">
          <div>
            <p class="text-white font-medium">Robbie's of Islamorada</p>
            <p class="text-white/60">Mon–Sun: 7:00am – 9:00pm</p>
          </div>
          <div>
            <p class="text-white font-medium">Hungry Tarpon Restaurant</p>
            <p class="text-white/60">Mon–Sun: 6:30am – 9:00pm</p>
          </div>
          <div>
            <p class="text-white font-medium">Tarpon Booth</p>
            <p class="text-white/60">Mon–Sun: 7:00am – 9:00pm</p>
          </div>
          <div>
            <p class="text-white font-medium">Captain Michael Fishing</p>
            <p class="text-white/60">Mon–Sun: 7:00am – 8:00pm</p>
          </div>
        </div>
      </div>
    </div>

    <div class="border-t border-white/10 mt-12 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-white/40">
      <p>© {new Date().getFullYear()} Robbie's Marina of Islamorada. All rights reserved.</p>
      <p>Close to perfect, far from normal.</p>
    </div>
  </div>
</footer>
