---
interface Props {
  title: string;
  description: string;
  href: string;
  emoji?: string;
  gradient?: string;
  image?: string;
}

const { title, description, href, emoji, gradient = 'from-blue-900 to-blue-700', image } = Astro.props;
---

<a href={href} class="group block rounded-xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-0.5 bg-white border border-gray-100">
  <!-- Image — shorter on mobile -->
  <div class={`relative h-32 sm:h-40 md:h-44 flex items-center justify-center overflow-hidden ${!image ? `bg-gradient-to-br ${gradient}` : ''}`}>
    {image ? (
      <img
        src={image}
        alt={title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
      />
    ) : (
      <span class="text-5xl">{emoji}</span>
    )}
    {image && <div class="absolute inset-0 bg-black/10 group-hover:bg-black/0 transition-colors"></div>}
  </div>
  <!-- Text — compact on mobile -->
  <div class="p-3 sm:p-5">
    <h3 class="font-bold text-gray-900 text-sm sm:text-base mb-1 group-hover:text-amber-600 transition-colors leading-tight">{title}</h3>
    <p class="text-gray-500 text-xs sm:text-sm leading-relaxed line-clamp-2 mb-2 sm:mb-3 hidden sm:block">{description}</p>
    <span class="text-amber-600 text-xs font-semibold">Learn More →</span>
  </div>
</a>
